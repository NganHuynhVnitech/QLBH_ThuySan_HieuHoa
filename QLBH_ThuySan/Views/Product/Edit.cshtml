@model QLBH_ThuySan.Models.HangHoa

@{
    ViewData["Title"] = "Cập Nhật Hàng Hóa";
    // Prepare existing units index
    var unitCount = Model.DonViTinhs != null ? Model.DonViTinhs.Count : 0;
}

<div class="container">
    <h2 class="mb-3">Cập Nhật Hàng Hóa</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="MaHang" />
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-warning text-dark">Thông tin cơ bản</div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Mã Hàng</label>
                            <input asp-for="MaHang" class="form-control" disabled />
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="TenHang" class="control-label fw-bold">Tên Hàng</label>
                            <input asp-for="TenHang" class="form-control" />
                            <span asp-validation-for="TenHang" class="text-danger"></span>
                        </div>
                         <div class="form-group mb-3">
                            <label asp-for="DonViTinh" class="control-label fw-bold">Đơn Vị Cơ Bản</label>
                            <input asp-for="DonViTinh" class="form-control" />
                            <span asp-validation-for="DonViTinh" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="GiaVonHienTai" class="control-label">Giá Vốn</label>
                                    <input asp-for="GiaVonHienTai" class="form-control" type="number" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="GiaBanHienTai" class="control-label">Giá Bán (Cơ bản)</label>
                                    <input asp-for="GiaBanHienTai" class="form-control" type="number" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                 <!-- Unit Conversion Section -->
                <div class="card">
                    <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                        <span>Đơn Vị Tính Quy Đổi</span>
                        <button type="button" class="btn btn-sm btn-light" onclick="addUnitRow()">
                            <i class="bi bi-plus-circle"></i> Thêm Đơn Vị
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên Đơn Vị</th>
                                    <th>Giá Trị Quy Đổi</th>
                                    <th>Giá Bán</th>
                                    <th>Mã Hàng Quy Đổi</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="unitTableBody">
                                @if (Model.DonViTinhs != null)
                                {
                                    int i = 0;
                                    foreach (var unit in Model.DonViTinhs)
                                    {
                                        <tr id="unitRow_@i">
                                            <td>
                                                <input type="text" name="units[@i].TenDonVi" class="form-control form-control-sm" required value="@unit.TenDonVi" />
                                                <input type="hidden" name="units[@i].Id" value="@unit.Id" />
                                            </td>
                                            <td>
                                                <input type="number" name="units[@i].TyLeQuyDoi" class="form-control form-control-sm" value="@unit.TyLeQuyDoi" />
                                            </td>
                                            <td>
                                                <input type="number" name="units[@i].GiaBan" class="form-control form-control-sm" value="@unit.GiaBan" />
                                            </td>
                                            <td>
                                                 <input type="text" name="units[@i].MaHangDonVi" class="form-control form-control-sm" value="@unit.MaHangDonVi" />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeRow(@i)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Cập Nhật</button>
            <a asp-action="Index" class="btn btn-secondary">Quay Lại</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let unitIndex = @(Model.DonViTinhs?.Count ?? 0);

        function addUnitRow() {
            const html = `
                <tr id="unitRow_${unitIndex}">
                    <td>
                        <input type="text" name="units[${unitIndex}].TenDonVi" class="form-control form-control-sm" required placeholder="Tên ĐV" />
                    </td>
                    <td>
                        <input type="number" name="units[${unitIndex}].TyLeQuyDoi" class="form-control form-control-sm" value="1" placeholder="SL đổi" />
                    </td>
                    <td>
                        <input type="number" name="units[${unitIndex}].GiaBan" class="form-control form-control-sm" value="0" placeholder="Giá bán" />
                    </td>
                    <td>
                         <input type="text" name="units[${unitIndex}].MaHangDonVi" class="form-control form-control-sm" placeholder="Mã riêng" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeRow(${unitIndex})">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
            document.getElementById('unitTableBody').insertAdjacentHTML('beforeend', html);
            unitIndex++;
        }

        function removeRow(index) {
            document.getElementById(`unitRow_${index}`).remove();
        }
    </script>
}
