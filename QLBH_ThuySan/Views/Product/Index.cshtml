@model IEnumerable<QLBH_ThuySan.Models.HangHoa>

@{
    ViewData["Title"] = "Quản Lý Hàng Hóa";
}

<div class="row pt-4 mb-4">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold">Danh Mục Hàng Hóa</h1>
        <p class="text-muted">Quản lý danh sách sản phẩm, giá vốn và giá bán hiện tại.</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Quay Lại
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm Hàng Hóa
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form asp-action="Index" method="get" class="row g-3 align-items-end" id="searchForm">
            <div class="col-md-3">
                <label for="searchMa" class="form-label small fw-bold">Mã Hàng</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-hash"></i></span>
                    <input type="text" name="searchMa" id="searchMa" class="form-control" placeholder="Mã..." value="@ViewData["searchMa"]" />
                </div>
            </div>
            <div class="col-md-6">
                <label for="searchTen" class="form-label small fw-bold">Tên Hàng Hóa</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                    <input type="text" name="searchTen" id="searchTen" class="form-control" placeholder="Tìm theo tên sản phẩm..." value="@ViewData["searchTen"]" />
                </div>
            </div>
            <div class="col-md-3 text-end">
                <div class="btn-group btn-group-sm w-100">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Tìm Kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa lọc">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        @{
                            var currentSort = ViewData["CurrentSort"] as string;
                            var searchParams = new Dictionary<string, string>
                            {
                                { "searchMa", ViewData["searchMa"]?.ToString() ?? "" },
                                { "searchTen", ViewData["searchTen"]?.ToString() ?? "" }
                            };

                            string GetSortIcon(string? sortOrder, string ascTarget, string descTarget)
                            {
                                if (sortOrder == ascTarget) return "<i class='bi bi-sort-up text-primary'></i>";
                                if (sortOrder == descTarget) return "<i class='bi bi-sort-down text-primary'></i>";
                                return "<i class='bi bi-arrow-down-up text-muted small'></i>";
                            }
                        }
                        <th class="ps-3">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["MaSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Mã Hàng @Html.Raw(GetSortIcon(currentSort, "", "ma_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["TenSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Tên Hàng Hóa @Html.Raw(GetSortIcon(currentSort, "name_asc", "name_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["DvtSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                ĐVT @Html.Raw(GetSortIcon(currentSort, "unit_asc", "unit_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["QcSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Quy Cách @Html.Raw(GetSortIcon(currentSort, "qc_asc", "qc_desc"))
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["VonSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                @Html.Raw(GetSortIcon(currentSort, "cost_asc", "cost_desc")) Giá Vốn
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["BanSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                @Html.Raw(GetSortIcon(currentSort, "price_asc", "price_desc")) Giá Bán
                            </a>
                        </th>
                        <th class="text-center small fw-bold text-uppercase">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3"><span class="badge bg-light text-dark border">@item.MaHang</span></td>
                            <td class="fw-bold">@item.TenHang</td>
                            <td>@item.DonViTinh</td>
                            <td>@item.QuyCach</td>
                            <td class="text-end text-muted">@string.Format("{0:N0}", item.GiaVonHienTai)</td>
                            <td class="text-end fw-bold text-success">@string.Format("{0:N0}", item.GiaBanHienTai)</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.MaHang" class="btn btn-outline-primary" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaHang" title="Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal stays largely the same but with better styling -->
                                <div class="modal fade" id="deleteModal-@item.MaHang" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title"><i class="bi bi-exclamation-octagon"></i> Xác nhận xóa</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                Bạn có chắc chắn muốn xóa sản phẩm <strong>@item.TenHang</strong>?<br/>
                                                <small class="text-danger mt-2 d-block"><i class="bi bi-info-circle"></i> Lưu ý: Không thể xóa nếu đã có phát sinh nhập/xuất trong hệ thống.</small>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@item.MaHang">
                                                    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
