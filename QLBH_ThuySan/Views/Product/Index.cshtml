@model IEnumerable<QLBH_ThuySan.Models.HangHoa>

@{
    ViewData["Title"] = "Quản Lý Hàng Hóa";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>Quản Lý Hàng Hóa</h1>
        <p class="text-muted">Danh sách sản phẩm và hàng hóa kinh doanh</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm Mới
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end" id="searchForm">
            <div class="col-md-4">
                <label for="searchMa" class="form-label">Mã Hàng</label>
                <input type="text" name="searchMa" id="searchMa" class="form-control" placeholder="Tìm theo mã hàng..." value="@ViewData["searchMa"]" />
            </div>
            <div class="col-md-5">
                <label for="searchTen" class="form-label">Tên Hàng Hóa</label>
                <input type="text" name="searchTen" id="searchTen" class="form-control" placeholder="Tìm theo tên hàng hóa..." value="@ViewData["searchTen"]" />
            </div>
            <div class="col-md-3 text-end">
                <div class="btn-group w-100">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i> Tìm Kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        @{
                            var currentSort = ViewData["CurrentSort"] as string;
                            var searchParams = new Dictionary<string, string>
                            {
                                { "searchMa", ViewData["searchMa"]?.ToString() ?? "" },
                                { "searchTen", ViewData["searchTen"]?.ToString() ?? "" }
                            };

                            string GetSortIcon(string? sortOrder, string ascTarget, string descTarget)
                            {
                                if (sortOrder == ascTarget) return "<i class='bi bi-sort-up'></i>";
                                if (sortOrder == descTarget) return "<i class='bi bi-sort-down'></i>";
                                return "<i class='bi bi-arrow-down-up text-muted small'></i>";
                            }
                        }
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["MaSortParm"]" class="text-decoration-none text-dark">
                                Mã Hàng @Html.Raw(GetSortIcon(currentSort, "", "ma_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["TenSortParm"]" class="text-decoration-none text-dark">
                                Tên Hàng Hóa @Html.Raw(GetSortIcon(currentSort, "name_asc", "name_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["DvtSortParm"]" class="text-decoration-none text-dark">
                                ĐVT @Html.Raw(GetSortIcon(currentSort, "unit_asc", "unit_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["QcSortParm"]" class="text-decoration-none text-dark">
                                Quy Cách @Html.Raw(GetSortIcon(currentSort, "qc_asc", "qc_desc"))
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["VonSortParm"]" class="text-decoration-none text-dark">
                                @Html.Raw(GetSortIcon(currentSort, "cost_asc", "cost_desc")) Giá Vốn
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["BanSortParm"]" class="text-decoration-none text-dark">
                                @Html.Raw(GetSortIcon(currentSort, "price_asc", "price_desc")) Giá Bán
                            </a>
                        </th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td><span class="badge bg-secondary">@item.MaHang</span></td>
                            <td class="fw-bold">@item.TenHang</td>
                            <td>@item.DonViTinh</td>
                            <td>@item.QuyCach</td>
                            <td class="text-end">@string.Format("{0:N0}", item.GiaVonHienTai)</td>
                            <td class="text-end fw-bold text-success">@string.Format("{0:N0}", item.GiaBanHienTai)</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.MaHang" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        Sửa
                                    </a>
                                    <!-- Button trigger modal -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaHang" title="Xóa">
                                        Xóa
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@item.MaHang" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Xác nhận xóa</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Bạn có chắc chắn muốn xóa sản phẩm <strong>@item.TenHang</strong>?<br/>
                                                <small class="text-danger">Lưu ý: Không thể xóa nếu đã có phát sinh nhập/xuất.</small>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@item.MaHang">
                                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
