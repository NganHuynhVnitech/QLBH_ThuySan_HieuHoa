@model QLBH_ThuySan.Models.HangHoa

@{
    ViewData["Title"] = "Thêm Mới Hàng Hóa";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Thêm Mới Hàng Hóa</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaHang" class="form-label">Mã Hàng</label>
                                <input asp-for="MaHang" class="form-control" placeholder="VD: SP001" required />
                                <span asp-validation-for="MaHang" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenHang" class="form-label">Tên Hàng Hóa</label>
                                <input asp-for="TenHang" class="form-control" required />
                                <span asp-validation-for="TenHang" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DonViTinh" class="form-label">Đơn Vị Tính</label>
                                <input asp-for="DonViTinh" class="form-control" placeholder="VD: Chai, Kg, Bao" />
                                <span asp-validation-for="DonViTinh" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="QuyCach" class="form-label">Quy Cách</label>
                                <input asp-for="QuyCach" class="form-control" placeholder="VD: 1 Lít, 500g" />
                                <span asp-validation-for="QuyCach" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="GiaVonHienTai" class="form-label">Giá Vốn Ban Đầu</label>
                                <input asp-for="GiaVonHienTai" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="GiaVonHienTai" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-4">
                                <label asp-for="GiaBanHienTai" class="form-label">Giá Bán Niêm Yết</label>
                                <input asp-for="GiaBanHienTai" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="GiaBanHienTai" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Quay Lại</a>
                            <button type="submit" class="btn btn-primary">Lưu Lại</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
