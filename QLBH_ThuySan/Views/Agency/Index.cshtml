@model IEnumerable<QLBH_ThuySan.Models.DaiLy>

@{
    ViewData["Title"] = "Quản Lý Đại Lý";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>Quản Lý Đại Lý</h1>
        <p class="text-muted">Danh sách đại lý thuộc hệ thống</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm Mới
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đại Lý</th>
                        <th>Tên Đại Lý</th>
                        <th>Loại Đại Lý</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td><span class="badge bg-secondary">@item.MaDaiLy</span></td>
                            <td class="fw-bold">@item.TenDaiLy</td>
                            <td>
                                @if (item.LoaiDaiLy == "NHAP_A") {
                                    <span class="badge bg-primary">Nhập A</span>
                                } else if (item.LoaiDaiLy == "NHAP_B") {
                                    <span class="badge bg-info text-dark">Nhập B</span>
                                } else if (item.LoaiDaiLy == "BAN_C") {
                                    <span class="badge bg-success">Bán C</span>
                                } else {
                                    <span class="badge bg-secondary">@item.LoaiDaiLy</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.MaDaiLy" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        Sửa
                                    </a>
                                    <!-- Button trigger modal -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaDaiLy" title="Xóa">
                                        Xóa
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@item.MaDaiLy" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Xác nhận xóa</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Bạn có chắc chắn muốn xóa đại lý <strong>@item.TenDaiLy</strong>?<br/>
                                                <small class="text-danger">Lưu ý: Không thể xóa nếu đã có phát sinh nhập/xuất hoặc quản lý kho.</small>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@item.MaDaiLy">
                                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
