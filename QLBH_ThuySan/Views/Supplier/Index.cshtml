@model IEnumerable<QLBH_ThuySan.Models.NhaCungCap>

@{
    ViewData["Title"] = "Quản Lý Nhà Cung Cấp";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>Quản Lý Nhà Cung Cấp</h1>
        <p class="text-muted">Danh sách đối tác cung cấp hàng hóa</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm Mới
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end" id="searchForm">
            <div class="col-md-2">
                <label for="searchMa" class="form-label">Mã NCC</label>
                <input type="text" name="searchMa" id="searchMa" class="form-control" placeholder="Mã NCC..." value="@ViewData["searchMa"]" />
            </div>
            <div class="col-md-3">
                <label for="searchTen" class="form-label">Tên Nhà Cung Cấp</label>
                <input type="text" name="searchTen" id="searchTen" class="form-control" placeholder="Tên NCC..." value="@ViewData["searchTen"]" />
            </div>
            <div class="col-md-2">
                <label for="searchSdt" class="form-label">Điện Thoại</label>
                <input type="text" name="searchSdt" id="searchSdt" class="form-control" placeholder="SĐT..." value="@ViewData["searchSdt"]" />
            </div>
            <div class="col-md-3">
                <label for="searchDiaChi" class="form-label">Địa Chỉ</label>
                <input type="text" name="searchDiaChi" id="searchDiaChi" class="form-control" placeholder="Địa chỉ..." value="@ViewData["searchDiaChi"]" />
            </div>
            <div class="col-md-10 mt-3">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="searchCoNo" id="searchCoNo" value="true" @((bool)(ViewData["searchCoNo"] ?? false) ? "checked" : "")>
                    <label class="form-check-label" for="searchCoNo">Chỉ hiện NCC có dư nợ (>0)</label>
                </div>
            </div>
            <div class="col-md-2 text-end mt-3">
                <div class="btn-group w-100">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Tìm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        @{
                            var currentSort = ViewData["CurrentSort"] as string;
                            var searchParams = new Dictionary<string, string>
                            {
                                { "searchMa", ViewData["searchMa"]?.ToString() ?? "" },
                                { "searchTen", ViewData["searchTen"]?.ToString() ?? "" },
                                { "searchSdt", ViewData["searchSdt"]?.ToString() ?? "" },
                                { "searchDiaChi", ViewData["searchDiaChi"]?.ToString() ?? "" },
                                { "searchCoNo", ViewData["searchCoNo"]?.ToString()?.ToLower() ?? "false" }
                            };

                            string GetSortIcon(string? sortOrder, string ascTarget, string descTarget)
                            {
                                if (sortOrder == ascTarget) return "<i class='bi bi-sort-up'></i>";
                                if (sortOrder == descTarget) return "<i class='bi bi-sort-down'></i>";
                                return "<i class='bi bi-arrow-down-up text-muted small'></i>";
                            }
                        }
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["MaSortParm"]" class="text-decoration-none text-dark">
                                Mã NCC @Html.Raw(GetSortIcon(currentSort, "", "ma_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["TenSortParm"]" class="text-decoration-none text-dark">
                                Tên NCC @Html.Raw(GetSortIcon(currentSort, "name_asc", "name_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["SdtSortParm"]" class="text-decoration-none text-dark">
                                SĐT @Html.Raw(GetSortIcon(currentSort, "sdt_asc", "sdt_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["DiaChiSortParm"]" class="text-decoration-none text-dark">
                                Địa Chỉ @Html.Raw(GetSortIcon(currentSort, "addr_asc", "addr_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["TaxSortParm"]" class="text-decoration-none text-dark">
                                MST @Html.Raw(GetSortIcon(currentSort, "tax_asc", "tax_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["DaySortParm"]" class="text-decoration-none text-dark">
                                Nợ (Ngày) @Html.Raw(GetSortIcon(currentSort, "day_asc", "day_desc"))
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["DebtSortParm"]" class="text-decoration-none text-dark">
                                @Html.Raw(GetSortIcon(currentSort, "debt_asc", "debt_desc")) Dư Nợ
                            </a>
                        </th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td><span class="badge bg-secondary">@item.MaDoiTuong</span></td>
                            <td class="fw-bold">@item.TenDoiTuong</td>
                            <td>@item.SoDienThoai</td>
                            <td>@item.DiaChi</td>
                            <td>@item.MaSoThue</td>
                            <td>@item.SoNgayDuocNo</td>
                            <td class="text-danger fw-bold">@string.Format("{0:N0}", item.DuNoLuyKe ?? 0) đ</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.MaDoiTuong" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        Sửa
                                    </a>
                                    <!-- Button trigger modal -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaDoiTuong" title="Xóa">
                                        Xóa
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@item.MaDoiTuong" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Xác nhận xóa</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Bạn có chắc chắn muốn xóa nhà cung cấp <strong>@item.TenDoiTuong</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@item.MaDoiTuong">
                                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
