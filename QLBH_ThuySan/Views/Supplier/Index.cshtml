@model IEnumerable<QLBH_ThuySan.Models.NhaCungCap>

@{
    ViewData["Title"] = "Quản Lý Nhà Cung Cấp";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>Quản Lý Nhà Cung Cấp</h1>
        <p class="text-muted">Danh sách đối tác cung cấp hàng hóa</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm Mới
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã NCC</th>
                        <th>Tên Nhà Cung Cấp</th>
                        <th>Điện Thoại</th>
                        <th>Địa Chỉ</th>
                        <th>Mã Số Thuế</th>
                        <th>Nợ (Ngày)</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td><span class="badge bg-secondary">@item.MaDoiTuong</span></td>
                            <td class="fw-bold">@item.TenDoiTuong</td>
                            <td>@item.SoDienThoai</td>
                            <td>@item.DiaChi</td>
                            <td>@item.MaSoThue</td>
                            <td>@item.SoNgayDuocNo</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.MaDoiTuong" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        Sửa
                                    </a>
                                    <!-- Button trigger modal -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaDoiTuong" title="Xóa">
                                        Xóa
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@item.MaDoiTuong" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Xác nhận xóa</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Bạn có chắc chắn muốn xóa nhà cung cấp <strong>@item.TenDoiTuong</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@item.MaDoiTuong">
                                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
