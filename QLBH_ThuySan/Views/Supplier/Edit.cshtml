@model QLBH_ThuySan.Models.NhaCungCap

@{
    ViewData["Title"] = "Chỉnh Sửa Nhà Cung Cấp";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Chỉnh Sửa Nhà Cung Cấp</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="MaDoiTuong" />
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Mã Nhà Cung Cấp</label>
                                <input value="@Model.MaDoiTuong" class="form-control" disabled readonly />
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenDoiTuong" class="form-label">Tên Nhà Cung Cấp</label>
                                <input asp-for="TenDoiTuong" class="form-control" required />
                                <span asp-validation-for="TenDoiTuong" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoDienThoai" class="form-label">Số Điện Thoại</label>
                                <input asp-for="SoDienThoai" class="form-control" />
                                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaSoThue" class="form-label">Mã Số Thuế</label>
                                <input asp-for="MaSoThue" class="form-control" />
                                <span asp-validation-for="MaSoThue" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiaChi" class="form-label">Địa Chỉ</label>
                            <input asp-for="DiaChi" class="form-control" />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="SoNgayDuocNo" class="form-label">Số Ngày Được Nợ</label>
                            <input asp-for="SoNgayDuocNo" class="form-control" type="number" />
                            <span asp-validation-for="SoNgayDuocNo" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Quay Lại</a>
                            <button type="submit" class="btn btn-primary">Cập Nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
