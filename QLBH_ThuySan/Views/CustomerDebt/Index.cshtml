@model IEnumerable<QLBH_ThuySan.Models.KhachHang>

@{
    ViewData["Title"] = "Theo Dõi Công Nợ Khách Hàng";
}

<h2>Theo Dõi Công Nợ Khách Hàng</h2>

<div class="row mb-3">
    <div class="col-md-12">
        <form asp-action="Index" method="get" class="card card-body bg-light">
            <div class="row g-2">
                <div class="col-md-2">
                    <input type="text" name="searchMaKh" value="@ViewData["searchMaKh"]" class="form-control" placeholder="Mã KH" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="searchTenKh" value="@ViewData["searchTenKh"]" class="form-control" placeholder="Tên KH" />
                </div>
                <div class="col-md-2">
                    <input type="text" name="searchSdt" value="@ViewData["searchSdt"]" class="form-control" placeholder="SĐT" />
                </div>
                <div class="col-md-2">
                    <input type="text" name="searchDiaChi" value="@ViewData["searchDiaChi"]" class="form-control" placeholder="Địa Chỉ" />
                </div>
                <div class="col-md-2">
                    <input type="text" name="searchAoNuoi" value="@ViewData["searchAoNuoi"]" class="form-control" placeholder="Ao Nuôi" />
                </div>
                <div class="col-md-1 d-flex align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="filterDuNo" id="filterDuNo" value="true" @(Convert.ToBoolean(ViewData["filterDuNo"]) ? "checked" : "") />
                        <label class="form-check-label" for="filterDuNo">Nợ >0</label>
                    </div>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-12 text-end">
                    <a asp-action="Create" class="btn btn-primary me-2">Thêm Khách Hàng Mới</a>
                    <button type="submit" class="btn btn-success"><i class="bi bi-search"></i> Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-secondary">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["MaSortParm"]" 
                       asp-route-searchMaKh="@ViewData["searchMaKh"]" asp-route-searchTenKh="@ViewData["searchTenKh"]"
                       asp-route-searchSdt="@ViewData["searchSdt"]" asp-route-searchDiaChi="@ViewData["searchDiaChi"]"
                       asp-route-searchAoNuoi="@ViewData["searchAoNuoi"]" asp-route-filterDuNo="@ViewData["filterDuNo"]"
                       class="text-decoration-none text-dark">Mã Khách Hàng <i class="bi bi-arrow-down-up small text-muted"></i></a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["TenSortParm"]" 
                       asp-route-searchMaKh="@ViewData["searchMaKh"]" asp-route-searchTenKh="@ViewData["searchTenKh"]"
                       asp-route-searchSdt="@ViewData["searchSdt"]" asp-route-searchDiaChi="@ViewData["searchDiaChi"]"
                       asp-route-searchAoNuoi="@ViewData["searchAoNuoi"]" asp-route-filterDuNo="@ViewData["filterDuNo"]"
                       class="text-decoration-none text-dark">Tên Khách Hàng <i class="bi bi-arrow-down-up small text-muted"></i></a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["SdtSortParm"]" 
                       asp-route-searchMaKh="@ViewData["searchMaKh"]" asp-route-searchTenKh="@ViewData["searchTenKh"]"
                       asp-route-searchSdt="@ViewData["searchSdt"]" asp-route-searchDiaChi="@ViewData["searchDiaChi"]"
                       asp-route-searchAoNuoi="@ViewData["searchAoNuoi"]" asp-route-filterDuNo="@ViewData["filterDuNo"]"
                       class="text-decoration-none text-dark">Số Điện Thoại <i class="bi bi-arrow-down-up small text-muted"></i></a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["DcSortParm"]" 
                       asp-route-searchMaKh="@ViewData["searchMaKh"]" asp-route-searchTenKh="@ViewData["searchTenKh"]"
                       asp-route-searchSdt="@ViewData["searchSdt"]" asp-route-searchDiaChi="@ViewData["searchDiaChi"]"
                       asp-route-searchAoNuoi="@ViewData["searchAoNuoi"]" asp-route-filterDuNo="@ViewData["filterDuNo"]"
                       class="text-decoration-none text-dark">Địa Chỉ <i class="bi bi-arrow-down-up small text-muted"></i></a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["AoSortParm"]" 
                       asp-route-searchMaKh="@ViewData["searchMaKh"]" asp-route-searchTenKh="@ViewData["searchTenKh"]"
                       asp-route-searchSdt="@ViewData["searchSdt"]" asp-route-searchDiaChi="@ViewData["searchDiaChi"]"
                       asp-route-searchAoNuoi="@ViewData["searchAoNuoi"]" asp-route-filterDuNo="@ViewData["filterDuNo"]"
                       class="text-decoration-none text-dark">Ao Nuôi <i class="bi bi-arrow-down-up small text-muted"></i></a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["DuNoSortParm"]" 
                       asp-route-searchMaKh="@ViewData["searchMaKh"]" asp-route-searchTenKh="@ViewData["searchTenKh"]"
                       asp-route-searchSdt="@ViewData["searchSdt"]" asp-route-searchDiaChi="@ViewData["searchDiaChi"]"
                       asp-route-searchAoNuoi="@ViewData["searchAoNuoi"]" asp-route-filterDuNo="@ViewData["filterDuNo"]"
                       class="text-decoration-none text-dark">Dư Nợ Lũy Kế <i class="bi bi-arrow-down-up small text-muted"></i></a>
                </th>
                <th>Thao Tác</th>
            </tr>
        </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaDoiTuong</td>
                <td>@item.TenDoiTuong</td>
                <td>@item.SoDienThoai</td>
                <td>@item.DiaChi</td>
                <td>@item.AoNuoi</td>
                <td>
                    <strong class="@((item.DuNoLuyKe ?? 0) > 0 ? "text-danger" : "text-success")">
                        @((item.DuNoLuyKe ?? 0).ToString("N0")) VNĐ
                    </strong>
                    @if ((item.DuNoLuyKe ?? 0) < 0)
                    {
                        <br />
                        <span class="text-muted small">(Khách hàng thanh toán thừa, cần thối lại)</span>
                    }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@item.MaDoiTuong" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-eye"></i> Chi Tiết
                        </a>
                        @if ((item.DuNoLuyKe ?? 0) > 0)
                        {
                            <button type="button" class="btn btn-sm btn-success" onclick="openPayModal('@item.MaDoiTuong', @(item.DuNoLuyKe ?? 0))">
                                <i class="bi bi-cash-coin"></i> Thanh Toán
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- Modal Thanh Toán -->
<div class="modal fade" id="payBillModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/PrivateLedger/AddEntry" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Thu Tiền Khách Hàng <span id="payMaPhieuDisplay"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="payMaKhachHang" name="maKhachHang" />
                    <input type="hidden" name="loaiGiaoDich" value="THANH_TOAN" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Khách hàng còn nợ:</label>
                        <div class="input-group">
                            <input type="text" id="payRemainingDisplay" class="form-control bg-light" readonly />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền thu:</label>
                        <div class="input-group">
                            <input type="text" class="form-control border-success fw-bold" id="payAmountDisplay" required />
                            <input type="hidden" id="payAmount" name="soTienPhatSinh" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <div class="form-text">Hệ thống sẽ tự động trừ dần các phiếu nợ cũ nhất.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Diễn Giải</label>
                        <textarea class="form-control" id="payDienGiai" name="dienGiai" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success">Xác nhận thu tiền</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function formatNumberJS(n) {
            return n.replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        function openPayModal(id, remaining) {
            document.getElementById('payMaPhieuDisplay').innerText = id;
            document.getElementById('payMaKhachHang').value = id;
            document.getElementById('payRemainingDisplay').value = remaining.toLocaleString('vi-VN');
            
            var amountDisplay = document.getElementById('payAmountDisplay');
            var amountHidden = document.getElementById('payAmount');
            
            amountHidden.value = remaining;
            amountDisplay.value = formatNumberJS(remaining.toString());

            document.getElementById('payDienGiai').value = 'Thu tiền thanh toán nợ cho khách hàng ' + id;
            
            var modal = new bootstrap.Modal(document.getElementById('payBillModal'));
            modal.show();
        }

        document.getElementById('payAmountDisplay').addEventListener('input', function(e) {
            var value = e.target.value.replace(/\./g, '');
            if (value === "") {
                document.getElementById('payAmount').value = 0;
                return;
            }
            e.target.value = formatNumberJS(value);
            document.getElementById('payAmount').value = value;
        });
    </script>
}
