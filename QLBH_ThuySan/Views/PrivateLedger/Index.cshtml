@model IEnumerable<QLBH_ThuySan.Models.KhachHang>

@{
    ViewData["Title"] = "Sổ Riêng Khách Hàng - Quản Lý Công Nợ";
}

<h2>Sổ Riêng Khách Hàng - Quản Lý Công Nợ</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm Khách Hàng Mới</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã Khách Hàng</th>
            <th>Tên Khách Hàng</th>
            <th>Số Điện Thoại</th>
            <th>Địa Chỉ</th>
            <th>Ao Nuôi</th>
            <th>Dư Nợ Lũy Kế</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaDoiTuong</td>
                <td>@item.TenDoiTuong</td>
                <td>@item.SoDienThoai</td>
                <td>@item.DiaChi</td>
                <td>@item.AoNuoi</td>
                <td>
                    <strong class="@((item.DuNoLuyKe ?? 0) > 0 ? "text-danger" : "text-success")">
                        @((item.DuNoLuyKe ?? 0).ToString("N0")) VNĐ
                    </strong>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.MaDoiTuong" class="btn btn-sm btn-info">Chi Tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>
