@model IEnumerable<QLBH_ThuySan.Models.PhieuXuat>
@{
    ViewData["Title"] = "Lịch Sử Xuất Kho (Outbound)";
}

<div class="row pt-4 mb-4">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold">Quản Lý Xuất Kho</h1>
        <p class="text-muted">Theo dõi đơn hàng bán, trả hàng NCC, hao hụt và điều chuyển kho nội bộ.</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Quay Lại
        </a>
        <div class="dropdown d-inline-block">
            <button class="btn btn-primary dropdown-toggle shadow-sm" type="button" id="createSlipDropdown" data-bs-toggle="dropdown">
                <i class="bi bi-cart-plus"></i> Lập Phiếu Xuất
            </button>
            <ul class="dropdown-menu shadow animate slideIn">
                <li><a class="dropdown-item py-2" asp-action="Create"><i class="bi bi-bag-check me-2 text-success"></i> Bán Hàng</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2" asp-action="CreateSlip" asp-route-type="RETURN_VENDOR"><i class="bi bi-reply-all me-2 text-warning"></i> Trả hàng NCC</a></li>
                <li><a class="dropdown-item py-2" asp-action="CreateSlip" asp-route-type="DAMAGE_LOSS"><i class="bi bi-trash me-2 text-danger"></i> Xuất Hủy / Hao hụt</a></li>
                <li><a class="dropdown-item py-2" asp-action="CreateSlip" asp-route-type="TRANSFER"><i class="bi bi-arrow-left-right me-2 text-info"></i> Điều chuyển Kho</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row gx-3 gy-2 align-items-end" id="filterForm">
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase mb-1">Loại Xuất</label>
                <select id="filterType" name="type" class="form-select form-select-sm" onchange="applyFilters()">
                    <option value="">Tất cả loại</option>
                    <option value="SALES" selected="@(ViewData["CurrentType"]?.ToString() == "SALES")">Bán Hàng</option>
                    <option value="RETURN_VENDOR" selected="@(ViewData["CurrentType"]?.ToString() == "RETURN_VENDOR")">Trả Cung Cấp</option>
                    <option value="DAMAGE_LOSS" selected="@(ViewData["CurrentType"]?.ToString() == "DAMAGE_LOSS")">Hao Hụt / Hủy</option>
                    <option value="TRANSFER" selected="@(ViewData["CurrentType"]?.ToString() == "TRANSFER")">Điều Chuyển</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase mb-1">Thanh Toán</label>
                <select id="filterPaymentStatus" name="paymentStatus" class="form-select form-select-sm" onchange="applyFilters()">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Chưa Thanh Toán" selected="@(ViewData["PaymentStatus"]?.ToString() == "Chưa Thanh Toán")">Chưa Thanh Toán</option>
                    <option value="Đã Thanh Toán" selected="@(ViewData["PaymentStatus"]?.ToString() == "Đã Thanh Toán")">Đã Thanh Toán</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase mb-1">Đối tượng / Ghi chú</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="filterTargetInfo" name="targetInfo" value="@ViewData["TargetInfo"]" class="form-control" placeholder="Tìm tên khách, NCC..." onkeypress="if(event.keyCode==13) applyFilters()"/>
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase mb-1">Từ ngày</label>
                <input type="date" id="filterFromDate" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-control-sm" onchange="applyFilters()"/>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase mb-1">Đến ngày</label>
                <input type="date" id="filterToDate" name="toDate" value="@ViewData["ToDate"]" class="form-control form-control-sm" onchange="applyFilters()"/>
            </div>
            <div class="col-md-1">
                <button type="button" onclick="clearFilters()" class="btn btn-sm btn-outline-secondary w-100" title="Xóa lọc">
                    <i class="bi bi-x-circle"></i> Xóa
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 sort-header small fw-bold text-uppercase" data-column="MaPhieu" onclick="handleSort(this)">Mã Phiếu <i class="bi bi-arrow-down-up ms-1"></i></th>
                        <th class="sort-header small fw-bold text-uppercase" data-column="Date" data-order="desc" onclick="handleSort(this)">Ngày Xuất <i class="bi bi-sort-down ms-1"></i></th>
                        <th class="sort-header small fw-bold text-uppercase" data-column="Type" onclick="handleSort(this)">Loại Hình <i class="bi bi-arrow-down-up ms-1"></i></th>
                        <th class="sort-header small fw-bold text-uppercase" data-column="Target" onclick="handleSort(this)">Đối Tượng / Nội Dung <i class="bi bi-arrow-down-up ms-1"></i></th>
                        <th class="text-end sort-header small fw-bold text-uppercase" data-column="Total" onclick="handleSort(this)">Thành Tiền <i class="bi bi-arrow-down-up ms-1"></i></th>
                        <th class="text-end small fw-bold text-uppercase">Còn Nợ</th>
                        <th class="sort-header small fw-bold text-uppercase text-center" data-column="Payment" onclick="handleSort(this)">TT <i class="bi bi-arrow-down-up ms-1"></i></th>
                        <th class="text-center small fw-bold text-uppercase">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="exportsTableBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3"><span class="badge bg-light text-dark border">@item.MaPhieu</span></td>
                            <td>@item.NgayXuat?.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (item.LoaiXuat)
                                {
                                    case "SALES": <span class="badge bg-primary">Bán Hàng</span>; break;
                                    case "RETURN_VENDOR": <span class="badge bg-warning text-dark">Trả NCC</span>; break;
                                    case "DAMAGE_LOSS": <span class="badge bg-danger">Hao Hụt</span>; break;
                                    case "TRANSFER": <span class="badge bg-info text-dark">Chuyển Kho</span>; break;
                                    default: <span class="badge bg-secondary">@item.LoaiXuat</span>; break;
                                }
                            </td>
                            <td>
                                @if (item.LoaiXuat == "SALES") { <span class="fw-bold">@item.IdKhachHangNavigation?.TenDoiTuong</span> }
                                else if (item.LoaiXuat == "RETURN_VENDOR") { <span>@item.IdNhaCungCapNavigation?.TenDoiTuong</span> }
                                else if (item.LoaiXuat == "TRANSFER") { <i class="bi bi-arrow-right me-1"></i> @item.MaKhoNhanNavigation?.TenKho }
                                else { <span class="small text-muted">@item.LyDo</span> }
                            </td>
                            <td class="text-end fw-bold text-primary">@item.SoPhaiThanhToan?.ToString("N0")</td>
                            <td class="text-end fw-bold text-danger">@item.SoChuaThanhToan?.ToString("N0")</td>
                            <td class="text-center">
                                @if (item.TrangThaiThanhToan == "Đã Thanh Toán" || item.TrangThaiThanhToan == "Hoàn Tất")
                                { <span class="badge bg-success">@item.TrangThaiThanhToan</span> }
                                else { <span class="badge bg-light text-dark border">@item.TrangThaiThanhToan</span> }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.MaPhieu" class="btn btn-outline-info" title="Xem Chi Tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (item.LoaiXuat == "SALES" && (item.SoChuaThanhToan ?? 0) > 0)
                                    {
                                        <button type="button" class="btn btn-success" onclick="openPayModal('@item.MaPhieu', @(item.SoChuaThanhToan ?? 0))" title="Thu Tiền">
                                            <i class="bi bi-cash-coin"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-danger" onclick="if(confirm('Bạn có chắc chắn muốn ẩn phiếu này? Số nợ liên quan sẽ được tự động điều chỉnh.')) document.getElementById('delete-form-@item.MaPhieu').submit();" title="Ẩn/Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                                <form id="delete-form-@item.MaPhieu" asp-action="Delete" asp-route-id="@item.MaPhieu" method="post" style="display:none;">
                                    @Html.AntiForgeryToken()
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thanh Toán -->
<div class="modal fade" id="payBillModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Pay" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Thu Tiền Phiếu <span id="payMaPhieuDisplay"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="payMaPhieu" name="id" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Khách hàng còn nợ:</label>
                        <div class="input-group">
                            <input type="text" id="payRemainingDisplay" class="form-control bg-light" readonly />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền thu:</label>
                        <div class="input-group">
                            <input type="text" class="form-control border-primary fw-bold" id="payAmountDisplay" required />
                            <input type="hidden" id="payAmount" name="amount" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <div class="form-text">Mặc định là thu toàn bộ phiếu.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Diễn Giải</label>
                        <textarea class="form-control" id="payDienGiai" name="dienGiai" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Xác nhận thu tiền</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSortColumn = "Date";
        let currentSortOrder = "desc";

        function clearFilters() {
            document.getElementById('filterType').value = '';
            document.getElementById('filterPaymentStatus').value = '';
            document.getElementById('filterTargetInfo').value = '';
            document.getElementById('filterFromDate').value = '';
            document.getElementById('filterToDate').value = '';

            currentSortColumn = "Date";
            currentSortOrder = "desc";

            document.querySelectorAll('.sort-header').forEach(h => {
                h.removeAttribute('data-order');
                const icon = h.querySelector('i');
                if (icon) icon.className = 'bi bi-arrow-down-up ms-1';
            });

            const defaultHeader = document.querySelector('.sort-header[data-column="Date"]');
            if (defaultHeader) {
                defaultHeader.setAttribute('data-order', 'desc');
                const currentIcon = defaultHeader.querySelector('i');
                if (currentIcon) currentIcon.className = 'bi bi-sort-down ms-1';
            }

            applyFilters();
        }

        function handleSort(header) {
            const column = header.getAttribute('data-column');
            let order = header.getAttribute('data-order') || '';

            if (order === '') order = 'desc';
            else if (order === 'desc') order = 'asc';
            else order = '';

            document.querySelectorAll('.sort-header').forEach(h => {
                h.removeAttribute('data-order');
                const icon = h.querySelector('i');
                if (icon) icon.className = 'bi bi-arrow-down-up ms-1';
            });

            header.setAttribute('data-order', order);
            const currentIcon = header.querySelector('i');
            if (currentIcon) {
                if (order === 'desc') currentIcon.className = 'bi bi-sort-down ms-1';
                else if (order === 'asc') currentIcon.className = 'bi bi-sort-up ms-1';
                else currentIcon.className = 'bi bi-arrow-down-up ms-1';
            }

            currentSortColumn = order === '' ? '' : column;
            currentSortOrder = order;
            applyFilters();
        }

        function openPayModal(maPhieu, remaining) {
            document.getElementById('payMaPhieuDisplay').innerText = maPhieu;
            document.getElementById('payMaPhieu').value = maPhieu;
            document.getElementById('payRemainingDisplay').value = remaining.toLocaleString('vi-VN');
            
            var amountDisplay = document.getElementById('payAmountDisplay');
            var amountHidden = document.getElementById('payAmount');
            
            amountHidden.value = remaining;
            amountDisplay.value = formatNumberJS(remaining.toString());

            document.getElementById('payDienGiai').value = 'Thu tiền thanh toán cho phiếu ' + maPhieu;
            
            var modal = new bootstrap.Modal(document.getElementById('payBillModal'));
            modal.show();
        }

        function formatNumberJS(n) {
            return n.replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        document.getElementById('payAmountDisplay').addEventListener('input', function(e) {
            var value = e.target.value.replace(/\./g, '');
            if (value === "") {
                document.getElementById('payAmount').value = 0;
                return;
            }
            e.target.value = formatNumberJS(value);
            document.getElementById('payAmount').value = value;
        });

        function applyFilters() {
            const type = document.getElementById('filterType').value;
            const paymentStatus = document.getElementById('filterPaymentStatus').value;
            const targetInfo = document.getElementById('filterTargetInfo').value;
            const fromDate = document.getElementById('filterFromDate').value;
            const toDate = document.getElementById('filterToDate').value;

            const qs = new URLSearchParams({
                type, paymentStatus, targetInfo, fromDate, toDate,
                sortOrder: currentSortOrder === '' ? '' : (currentSortOrder === 'desc' ? currentSortColumn.toLowerCase() + '_desc' : currentSortColumn)
            }).toString();

            fetch(`/Export/SearchJson?${qs}`)
                .then(res => res.json())
                .then(data => {
                    const tbody = document.getElementById('exportsTableBody');
                    tbody.innerHTML = '';
                    data.forEach(item => {
                        const tr = document.createElement('tr');
                        
                        let badgeClass = 'bg-secondary';
                        let badgeText = item.loaiXuat;
                        if(item.loaiXuat === 'SALES') { badgeClass = 'bg-success'; badgeText = 'Bán Hàng'; }
                        else if(item.loaiXuat === 'RETURN_VENDOR') { badgeClass = 'bg-warning text-dark'; badgeText = 'Trả Cung Cấp'; }
                        else if(item.loaiXuat === 'DAMAGE_LOSS') { badgeClass = 'bg-danger'; badgeText = 'Hao Hụt'; }
                        else if(item.loaiXuat === 'TRANSFER') { badgeClass = 'bg-info text-dark'; badgeText = 'Điều Chuyển'; }

                        tr.innerHTML = `
                            <td>${item.maPhieu}</td>
                            <td>${item.ngayXuat}</td>
                            <td><span class="badge ${badgeClass}">${badgeText}</span></td>
                            <td>${item.tenDoiTuong || ''}</td>
                            <td class="text-end fw-bold text-primary">${item.soPhaiThanhToan}</td>
                            <td class="text-end fw-bold text-success">${item.soDaThanhToan}</td>
                            <td class="text-end fw-bold text-danger">${item.soChuaThanhToan}</td>
                            <td><span class="badge ${item.trangThaiThanhToan === 'Đã Thanh Toán' || item.trangThaiThanhToan === 'Hoàn Tất' ? 'bg-success' : 'bg-secondary'}">${item.trangThaiThanhToan}</span></td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="/Export/Details/${item.maPhieu}" class="btn btn-sm btn-outline-info">Chi tiết</a>
                                    ${item.loaiXuat === 'SALES' && item.trangThaiThanhToan !== 'Đã Thanh Toán' && item.trangThaiThanhToan !== 'Hoàn Tất' ? 
                                        `<button type="button" class="btn btn-sm btn-success" onclick="openPayModal('${item.maPhieu}', ${item.soChuaThanhToanRaw})">$ Thanh Toán</button>` 
                                        : ''}
                                    <button type="button" class="btn btn-sm btn-danger" onclick="if(confirm('Bạn có chắc chắn muốn ẩn phiếu này? Số nợ liên quan sẽ được tự động điều chỉnh.')) document.getElementById('delete-form-${item.maPhieu}').submit();">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                                <form id="delete-form-${item.maPhieu}" action="/Export/Delete/${item.maPhieu}" method="post" style="display:none;">
                                    <input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name=\"__RequestVerificationToken\"]').value}">
                                </form>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                });
        }
    </script>
}

