@model IEnumerable<QLBH_ThuySan.Models.PhieuXuat>
@{
    ViewData["Title"] = "Lịch Sử Xuất Kho (Outbound)";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2>Lịch Sử Nghiệp Vụ Xuất Kho</h2>
    </div>
    <div class="col-md-6 text-end">
        <div class="dropdown d-inline-block">
            <button class="btn btn-primary dropdown-toggle" type="button" id="createSlipDropdown"
                data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-plus-circle"></i> Tạo Phiếu Xuất Kho
            </button>
            <ul class="dropdown-menu" aria-labelledby="createSlipDropdown">
                <li><a class="dropdown-item" asp-action="Create">Bán Hàng</a></li>
                <li><a class="dropdown-item" asp-action="CreateSlip" asp-route-type="RETURN_VENDOR">Trả hàng Nhà cung
                        cấp</a></li>
                <li><a class="dropdown-item" asp-action="CreateSlip" asp-route-type="DAMAGE_LOSS">Xuất Hủy / Hao hụt</a>
                </li>
                <li><a class="dropdown-item" asp-action="CreateSlip" asp-route-type="TRANSFER">Điều chuyển Kho</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <form method="get" asp-action="Index" class="row gx-2 gy-2 align-items-end mb-3">
            <div class="col-sm-2">
                <label class="form-label mb-0">Loại Xuất</label>
                <select id="filterType" name="type" class="form-select form-select-sm" onchange="applyFilters()">
                    <option value="">Tất cả</option>
                    <option value="SALES" selected="@(ViewData["CurrentType"]?.ToString() == "SALES")">Bán Hàng</option>
                    <option value="RETURN_VENDOR" selected="@(ViewData["CurrentType"]?.ToString() == "RETURN_VENDOR")">
                        Trả Cung Cấp</option>
                    <option value="DAMAGE_LOSS" selected="@(ViewData["CurrentType"]?.ToString() == "DAMAGE_LOSS")">Hao
                        Hụt</option>
                    <option value="TRANSFER" selected="@(ViewData["CurrentType"]?.ToString() == "TRANSFER")">Điều Chuyển
                    </option>
                </select>
            </div>
            <div class="col-sm-2">
                <label class="form-label mb-0">Thanh Toán</label>
                <select id="filterPaymentStatus" name="paymentStatus" class="form-select form-select-sm" onchange="applyFilters()">
                    <option value="">Tất cả</option>
                    <option value="Chưa Thanh Toán"
                        selected="@(ViewData["PaymentStatus"]?.ToString() == "Chưa Thanh Toán")">Chưa Thanh Toán
                    </option>
                    <option value="Đã Thanh Toán"
                        selected="@(ViewData["PaymentStatus"]?.ToString() == "Đã Thanh Toán")">Đã Thanh Toán</option>
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label mb-0">Thông tin nhận/đối tượng</label>
                <input type="text" id="filterTargetInfo" name="targetInfo" value="@ViewData["TargetInfo"]"
                    class="form-control form-control-sm" placeholder="Tên đối tượng/Lý do" 
                    onkeypress="if(event.keyCode==13) applyFilters()"/>
            </div>
            <div class="col-sm-2">
                <label class="form-label mb-0">Từ ngày</label>
                <input type="date" id="filterFromDate" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-control-sm" onchange="applyFilters()"/>
            </div>
            <div class="col-sm-2">
                <label class="form-label mb-0">Đến ngày</label>
                <input type="date" id="filterToDate" name="toDate" value="@ViewData["ToDate"]" class="form-control form-control-sm" onchange="applyFilters()"/>
            </div>
            <div class="col-sm-1 d-flex flex-column gap-1">
                <button type="button" onclick="applyFilters()" class="btn btn-sm btn-secondary w-100">Lọc</button>
                <button type="button" onclick="clearFilters()" class="btn btn-sm btn-outline-secondary w-100">Xóa</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th class="sort-header" data-column="MaPhieu" onclick="handleSort(this)">
                    Mã Phiếu <i class="bi bi-arrow-down-up ms-1"></i>
                </th>
                <th class="sort-header" data-column="Date" data-order="desc" onclick="handleSort(this)">
                    Ngày Xuất <i class="bi bi-sort-down ms-1"></i>
                </th>
                <th class="sort-header" data-column="Type" onclick="handleSort(this)">
                    Loại Phiếu <i class="bi bi-arrow-down-up ms-1"></i>
                </th>
                <th class="sort-header" data-column="Target" onclick="handleSort(this)">
                    Thông tin Nhận / Đối tượng <i class="bi bi-arrow-down-up ms-1"></i>
                </th>
                <th class="text-end sort-header" data-column="Total" onclick="handleSort(this)">
                    Số Phải TT <i class="bi bi-arrow-down-up ms-1"></i>
                </th>
                <th class="text-end">Đã TT</th>
                <th class="text-end">Còn Nợ</th>
                <th class="sort-header" data-column="Payment" onclick="handleSort(this)">
                    Thanh Toán <i class="bi bi-arrow-down-up ms-1"></i>
                </th>
                <th class="text-center">Thao Tác</th>
            </tr>
        </thead>
        <tbody id="exportsTableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaPhieu</td>
                    <td>@item.NgayXuat?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @switch (item.LoaiXuat)

                        {
                            case "SALES":
                                <span class="badge bg-success">Bán Hàng</span>
                                ; break;
                            case "RETURN_VENDOR":
                                <span class="badge bg-warning text-dark">Trả Cung Cấp</span>
                                ; break;
                            case "DAMAGE_LOSS":
                                <span class="badge bg-danger">Hao Hụt</span>
                                ; break;
                            case "TRANSFER":
                                <span class="badge bg-info text-dark">Điều Chuyển</span>
                                ; break;
                            default:
                                <span class="badge bg-secondary">@item.LoaiXuat</span>
                                ; break;

                        }
                    </td>
                    <td>
                        @if (item.LoaiXuat == "SALES")

                        {
                            <span class="text-muted">KH:</span> @item.IdKhachHangNavigation?.TenDoiTuong
                        }

                        else if (item.LoaiXuat == "RETURN_VENDOR")

                        {
                            <span class="text-muted">NCC:</span> @item.IdNhaCungCapNavigation?.TenDoiTuong
                        }

                        else if (item.LoaiXuat == "TRANSFER")

                        {
                            <span class="text-muted">Đến Kho:</span> @item.MaKhoNhanNavigation?.TenKho
                        }

                        else if (item.LoaiXuat == "DAMAGE_LOSS")

                        {
                            <span class="text-muted">Lý do:</span> @item.LyDo
                        }
                    </td>
                    <td class="text-end fw-bold text-primary">@item.SoPhaiThanhToan?.ToString("N0")</td>
                    <td class="text-end fw-bold text-success">@item.SoDaThanhToan?.ToString("N0")</td>
                    <td class="text-end fw-bold text-danger">@item.SoChuaThanhToan?.ToString("N0")</td>
                    <td>
                        @if (item.TrangThaiThanhToan == "Đã Thanh Toán" || item.TrangThaiThanhToan == "Hoàn Tất")

                        {
                            <span class="badge bg-success">@item.TrangThaiThanhToan</span>
                        }

                        else

                        {
                            <span class="badge bg-secondary">@item.TrangThaiThanhToan</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.MaPhieu" class="btn btn-sm btn-outline-info">Chi
                            tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let currentSortColumn = "Date";
        let currentSortOrder = "desc";

        function clearFilters() {
            document.getElementById('filterType').value = '';
            document.getElementById('filterPaymentStatus').value = '';
            document.getElementById('filterTargetInfo').value = '';
            document.getElementById('filterFromDate').value = '';
            document.getElementById('filterToDate').value = '';

            currentSortColumn = "Date";
            currentSortOrder = "desc";

            document.querySelectorAll('.sort-header').forEach(h => {
                h.removeAttribute('data-order');
                const icon = h.querySelector('i');
                if (icon) icon.className = 'bi bi-arrow-down-up ms-1';
            });

            const defaultHeader = document.querySelector('.sort-header[data-column="Date"]');
            if (defaultHeader) {
                defaultHeader.setAttribute('data-order', 'desc');
                const currentIcon = defaultHeader.querySelector('i');
                if (currentIcon) currentIcon.className = 'bi bi-sort-down ms-1';
            }

            applyFilters();
        }

        function handleSort(header) {
            const column = header.getAttribute('data-column');
            let order = header.getAttribute('data-order') || '';

            if (order === '') order = 'desc';
            else if (order === 'desc') order = 'asc';
            else order = '';

            document.querySelectorAll('.sort-header').forEach(h => {
                h.removeAttribute('data-order');
                const icon = h.querySelector('i');
                if (icon) icon.className = 'bi bi-arrow-down-up ms-1';
            });

            header.setAttribute('data-order', order);
            const currentIcon = header.querySelector('i');
            if (currentIcon) {
                if (order === 'desc') currentIcon.className = 'bi bi-sort-down ms-1';
                else if (order === 'asc') currentIcon.className = 'bi bi-sort-up ms-1';
                else currentIcon.className = 'bi bi-arrow-down-up ms-1';
            }

            currentSortColumn = order === '' ? '' : column;
            currentSortOrder = order;
            applyFilters();
        }

        function applyFilters() {
            const type = document.getElementById('filterType').value;
            const paymentStatus = document.getElementById('filterPaymentStatus').value;
            const targetInfo = document.getElementById('filterTargetInfo').value;
            const fromDate = document.getElementById('filterFromDate').value;
            const toDate = document.getElementById('filterToDate').value;

            const qs = new URLSearchParams({
                type, paymentStatus, targetInfo, fromDate, toDate,
                sortOrder: currentSortOrder === '' ? '' : (currentSortOrder === 'desc' ? currentSortColumn.toLowerCase() + '_desc' : currentSortColumn)
            }).toString();

            fetch(`/Export/SearchJson?${qs}`)
                .then(res => res.json())
                .then(data => {
                    const tbody = document.getElementById('exportsTableBody');
                    tbody.innerHTML = '';
                    data.forEach(item => {
                        const tr = document.createElement('tr');
                        
                        let badgeClass = 'bg-secondary';
                        let badgeText = item.loaiXuat;
                        if(item.loaiXuat === 'SALES') { badgeClass = 'bg-success'; badgeText = 'Bán Hàng'; }
                        else if(item.loaiXuat === 'RETURN_VENDOR') { badgeClass = 'bg-warning text-dark'; badgeText = 'Trả Cung Cấp'; }
                        else if(item.loaiXuat === 'DAMAGE_LOSS') { badgeClass = 'bg-danger'; badgeText = 'Hao Hụt'; }
                        else if(item.loaiXuat === 'TRANSFER') { badgeClass = 'bg-info text-dark'; badgeText = 'Điều Chuyển'; }

                        tr.innerHTML = `
                            <td>${item.maPhieu}</td>
                            <td>${item.ngayXuat}</td>
                            <td><span class="badge ${badgeClass}">${badgeText}</span></td>
                            <td>${item.tenDoiTuong || ''}</td>
                            <td class="text-end fw-bold text-primary">${item.soPhaiThanhToan}</td>
                            <td class="text-end fw-bold text-success">${item.soDaThanhToan}</td>
                            <td class="text-end fw-bold text-danger">${item.soChuaThanhToan}</td>
                            <td><span class="badge ${item.trangThaiThanhToan === 'Đã Thanh Toán' || item.trangThaiThanhToan === 'Hoàn Tất' ? 'bg-success' : 'bg-secondary'}">${item.trangThaiThanhToan}</span></td>
                            <td class="text-center">
                                <a href="/Export/Details/${item.maPhieu}" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                });
        }
    </script>
}

