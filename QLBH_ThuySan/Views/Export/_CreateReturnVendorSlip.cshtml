<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        // Hủy Bỏ button already has href to Export/Index
        
        let rowIdx = 2; // Starting with 2 rows initially 

        function calcTotal() {
            let tQty = 0;
            let tVal = 0;
            $('#productTable tbody tr').each(function () {
                let qtyStr = $(this).find('.qty-input').val();
                let prcStr = $(this).find('.price-input').val();
                let maHang = $(this).find('.product-select').length ? $(this).find('.product-select').val() : "DEFAULT";
                if(maHang) {
                    let qty = parseFloat(qtyStr || 0);
                    let prc = parseFloat(prcStr ? prcStr.replace(/,/g, '') : 0);
                    tQty += qty;
                    tVal += (qty * prc);
                }
            });
            $('#totalQty').text(tQty.toLocaleString('en-US'));
            $('#totalValue').text(tVal.toLocaleString('en-US'));
        }

        $(document).on('input', '.qty-input, .price-input', function() {
            calcTotal();
        });

        $('#addRowBtn').click(function () {
            var tr = \`
            <tr class="hover:bg-surface transition-colors" id="row-\${rowIdx}">
                <td class="px-6 py-5 align-top">
                    <div class="flex flex-col">
                        <select class="product-select w-full bg-surface-container-lowest border border-outline-variant/30 rounded-lg px-2 py-2 text-sm focus:ring-2 focus:ring-primary/20 appearance-none font-body">
                            <option value="">-- Chọn Hàng --</option>
                            @if (hangHoas != null) {
                                foreach (var h in hangHoas) {
                                    <option value="@h.MaHang" data-price="@h.GiaBanHienTai">@h.TenHang</option>
                                }
                            }
                        </select>
                        <div class="mt-2 flex gap-4">
                            <span class="text-[10px] font-medium text-stone-400 italic">Chọn hàng hóa để xem chi tiết tồn kho...</span>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-5 align-top">
                    <div class="flex items-center bg-surface-container-low rounded-lg px-2 py-1.5 border border-outline-variant/10">
                        <input class="w-full bg-transparent border-none focus:ring-0 text-sm font-bold text-stone-900 p-0 text-right qty-input" type="number" min="0.01" />
                        <span class="text-[10px] font-bold text-stone-300 ml-1">kg</span>
                    </div>
                </td>
                <td class="px-6 py-5 align-top">
                    <div class="flex items-center bg-surface-container-low rounded-lg px-2 py-1.5 border border-outline-variant/10">
                        <input class="w-full bg-transparent border-none focus:ring-0 text-sm font-bold text-stone-900 p-0 text-right price-input" type="text" />
                        <span class="text-[10px] font-bold text-stone-300 ml-1">đ</span>
                    </div>
                </td>
                <td class="px-6 py-5 align-top text-center">
                    <button type="button" class="text-tertiary hover:bg-error-container/20 p-2 rounded-lg transition-colors active:scale-95 removeBtn">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </td>
            </tr>\`;
            $('#productTable tbody').append(tr);
            rowIdx++;
        });

        $(document).on('click', '.removeBtn', function () {
            $(this).closest('tr').remove();
            calcTotal();
        });

        $(document).on('change', '.product-select', function() {
            var price = $(this).find('option:selected').data('price');
            $(this).closest('tr').find('.price-input').val(price || 0);
            
            // visually set container to active
            $(this).closest('tr').find('.bg-surface-container-low').removeClass('opacity-50').addClass('bg-surface-container');
            $(this).closest('tr').find('.text-stone-400').removeClass('text-stone-400').addClass('text-stone-900');
            
            calcTotal();
        });

        $('#submitBtn').click(function () {
            let items = [];
            
            // Read items from table
            $('#productTable tbody tr').each(function () {
                let maHang = "";
                let hasSelect = $(this).find('.product-select').length > 0;
                
                if(!hasSelect) {
                    // It's the static example active row 1, if user didn't delete it
                    // The prompt HTML didn't set a data-id, so let's skip or hardcode
                    return true; 
                } else {
                    maHang = $(this).find('.product-select').val();
                }

                if(maHang) {
                    let qtyStr = $(this).find('.qty-input').val();
                    let prcStr = $(this).find('.price-input').val();
                    let qty = parseFloat(qtyStr);
                    let price = parseFloat(prcStr ? prcStr.replace(/,/g, '') : 0);

                    if (qty > 0) {
                        items.push({ MaHang: maHang, SoLuong: qty, GiaBan: price });
                    }
                }
            });

            if (items.length === 0) {
                alert("Vui lòng chọn ít nhất 1 hàng hóa hợp lệ để xuất.");
                return;
            }

            let sourceCode = $('#SourceWarehouseCode').val();
            let vendorId = $('#VendorId').val();

            if (!sourceCode) {
                alert("Vui lòng chọn Kho Xuất.");
                return;
            }
            if (!vendorId) {
                alert("Vui lòng chọn Nhà Cung Cấp.");
                return;
            }

            var payload = {
                SourceWarehouseCode: sourceCode,
                VendorId: vendorId,
                Items: items
            };

            var apiUrl = "/api/inventory/outbound/return-vendor";

            $('#submitBtn').prop('disabled', true).text('Đang xử lý...');

            $.ajax({
                url: apiUrl,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    alert(res.message);
                    window.location.href = '@Url.Action("Index", "Export")';
                },
                error: function (xhr) {
                    $('#submitBtn').prop('disabled', false).text('Xác Nhận Xuất Kho');
                    var msg = xhr.responseJSON?.message || "Có lỗi xảy ra khi tạo phiếu.";
                    alert("Lỗi: " + msg);
                    console.error(xhr.responseText);
                }
            });
        });
    });
</script>
</body></html>
