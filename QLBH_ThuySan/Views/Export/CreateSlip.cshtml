@{
    var formType = Context.Request.Query["type"].ToString();
    string slipTitle = formType switch
    {
        "RETURN_VENDOR" => "Trả Hàng Cho Nhà Cung Cấp",
        "DAMAGE_LOSS" => "Hủy / Báo Cáo Hao Hụt",
        "TRANSFER" => "Điều Chuyển Kho",
        _ => "Tạo Phiếu Xuất"
    };
    ViewData["Title"] = slipTitle;

    var khos = ViewData["Khos"] as IEnumerable<dynamic>;
    var hangHoas = ViewData["HangHoas"] as IEnumerable<dynamic>;
    var nhaCungCaps = ViewData["NhaCungCaps"] as IEnumerable<dynamic>;
}

@if (formType == "RETURN_VENDOR")
{
    @await Html.PartialAsync("_CreateReturnVendorSlip")
}
else if (formType == "DAMAGE_LOSS")
{
    @await Html.PartialAsync("_CreateDamageLossSlip")
}
else if (formType == "TRANSFER")
{
    @await Html.PartialAsync("_CreateTransferSlip")
}
else
{
<div class="container mt-4">
    <h2>@slipTitle</h2>
    <hr />

    <form id="outboundForm">
        <input type="hidden" id="formType" value="@formType" />

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Kho Xuất (Nguồn)<span class="text-danger">*</span></label>
                <select id="SourceWarehouseCode" class="form-select" required>
                    <option value="">-- Chọn Kho --</option>
                    @if (khos != null) {
                        @foreach(var k in khos) {
                            <option value="@k.MaKho">@k.TenKho</option>
                        }
                    }
                </select>
            </div>

            @if (formType == "TRANSFER")
            {
                <div class="col-md-6">
                    <label class="form-label fw-bold text-primary">Kho Nhận (Đích)<span class="text-danger">*</span></label>
                    <select id="DestinationWarehouseCode" class="form-select" required>
                        <option value="">-- Chọn Kho Nhận --</option>
                        @if (khos != null) {
                            @foreach(var k in khos) {
                                <option value="@k.MaKho">@k.TenKho</option>
                            }
                        }
                    </select>
                </div>
            }
            else if (formType == "RETURN_VENDOR")
            {
                <div class="col-md-6">
                    <label class="form-label fw-bold text-warning">Nhà Cung Cấp<span class="text-danger">*</span></label>
                    <select id="VendorId" class="form-select" required>
                        <option value="">-- Chọn Nhà Cung Cấp --</option>
                        @if (nhaCungCaps != null) {
                            @foreach(var n in nhaCungCaps) {
                                <option value="@n.MaDoiTuong">@n.TenDoiTuong</option>
                            }
                        }
                    </select>
                </div>
            }
            else if (formType == "DAMAGE_LOSS")
            {
                <div class="col-md-6">
                    <label class="form-label fw-bold text-danger">Lý do Hủy / Hao Hụt<span class="text-danger">*</span></label>
                    <input type="text" id="Reason" class="form-control" placeholder="Ví dụ: Bể vỡ, hết hạn, hao hụt kho bãi" required />
                </div>
            }
        </div>

        <h4 class="mt-4">Danh Sách Hàng Hóa Xuất</h4>
        <table class="table table-bordered" id="productTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 40%">Hàng Hóa</th>
                    <th style="width: 25%">Số lượng</th>
                    <th>Giá Bán (Tùy chọn)</th>
                    <th style="width: 10%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <!-- Dynamic rows -->
            </tbody>
        </table>

        <button type="button" class="btn btn-outline-primary mb-4" id="addRowBtn">
            <i class="bi bi-plus"></i> Thêm Mặt Hàng
        </button>

        <div class="text-end">
            <a asp-action="Index" class="btn btn-secondary me-2">Hủy Bỏ</a>
            <button type="submit" class="btn btn-success" id="submitBtn">
                <i class="bi bi-check-circle"></i> Xác Nhận Xuất Kho
            </button>
        </div>
    </form>
</div>

<!-- Select Template -->
<template id="productSelectTemplate">
    <select class="form-select product-select" required>
        <option value="">-- Chọn HH --</option>
        @if (hangHoas != null) {
            @foreach(var h in hangHoas) {
                <option value="@h.MaHang" data-price="@h.GiaBanHienTai">@h.TenHang</option>
            }
        }
    </select>
</template>
}

@if (formType != "RETURN_VENDOR" && formType != "DAMAGE_LOSS" && formType != "TRANSFER")
{
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            let rowIdx = 0;

            function addRow() {
                var selectHtml = $('#productSelectTemplate').html();
                var tr = `
                    <tr id="row-${rowIdx}">
                        <td>${selectHtml}</td>
                        <td><input type="number" step="0.01" class="form-control qty-input" min="0.01" required /></td>
                        <td><input type="number" step="1000" class="form-control price-input" value="0" /></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-danger removeBtn"><i class="bi bi-trash"></i> Xóa</button></td>
                    </tr>
                `;
                $('#productTable tbody').append(tr);
                rowIdx++;
            }

            // Init one row
            addRow();

            $('#addRowBtn').click(function () {
                addRow();
            });

            $(document).on('click', '.removeBtn', function () {
                $(this).closest('tr').remove();
            });

            // Handle Product Selection Change to default price
            $(document).on('change', '.product-select', function() {
                var price = $(this).find('option:selected').data('price');
                $(this).closest('tr').find('.price-input').val(price || 0);
            });

            $('#outboundForm').submit(function (e) {
                e.preventDefault();

                // Build Payload
                var type = $('#formType').val();
                
                var items = [];
                $('#productTable tbody tr').each(function () {
                    var maHang = $(this).find('.product-select').val();
                    var qty = parseFloat($(this).find('.qty-input').val());
                    var price = parseFloat($(this).find('.price-input').val());

                    if (maHang && qty > 0) {
                        items.push({ MaHang: maHang, SoLuong: qty, GiaBan: price });
                    }
                });

                if (items.length === 0) {
                    alert("Vui lòng chọn ít nhất 1 hàng hóa hợp lệ để xuất.");
                    return;
                }

                var payload = {
                    SourceWarehouseCode: $('#SourceWarehouseCode').val(),
                    Items: items
                };

                var apiUrl = "/api/inventory/outbound/";

                if (type === "TRANSFER") {
                    payload.DestinationWarehouseCode = $('#DestinationWarehouseCode').val();
                    if (payload.SourceWarehouseCode === payload.DestinationWarehouseCode) {
                        alert("Kho nguồn và kho đích không được trùng nhau.");
                        return;
                    }
                    apiUrl += "transfer";
                } else if (type === "RETURN_VENDOR") {
                    payload.VendorId = $('#VendorId').val();
                    apiUrl += "return-vendor";
                } else if (type === "DAMAGE_LOSS") {
                    payload.Reason = $('#Reason').val();
                    apiUrl += "damage";
                }

                // Submit
                $('#submitBtn').prop('disabled', true).text('Đang xử lý...');

                $.ajax({
                    url: apiUrl,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (res) {
                        alert(res.message);
                        window.location.href = '@Url.Action("Index")';
                    },
                    error: function (xhr) {
                        $('#submitBtn').prop('disabled', false).text('Xác Nhận Xuất Kho');
                        var msg = xhr.responseJSON?.message || "Có lỗi xảy ra khi tạo phiếu.";
                        alert("Lỗi: " + msg);
                        console.error(xhr.responseText);
                    }
                });
            });
        });
    </script>
}
}
