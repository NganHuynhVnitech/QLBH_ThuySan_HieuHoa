@model IEnumerable<QLBH_ThuySan.Models.CauHinhChietKhau>

@{
    ViewData["Title"] = "Cấu Hình Chiết Khấu";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>Cấu Hình Chiết Khấu</h1>
        <p class="text-muted">Quản lý các quy luật tính chiết khấu cho Khách hàng & Nhà cung cấp</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm Quy Luật
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên Cấu Hình</th>
                        <th>Loại Quy Luật</th>
                        <th>Đối Tượng Áp Dụng</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold">@item.TenCauHinh</td>
                            <td>
                                @if (item.LoaiQuyLuat == "THEO_BAC") {
                                    <span class="badge bg-primary">Theo Bậc Thang</span>
                                } else {
                                    <span class="badge bg-info text-dark">Cố Định</span>
                                }
                            </td>
                            <td>
                                @if (item.DoiTuongApDung == "NCC") {
                                    <span class="badge bg-secondary">Nhà Cung Cấp</span>
                                } else {
                                    <span class="badge bg-success">Khách Hàng</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        Sửa
                                    </a>
                                    <!-- Button trigger modal -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id" title="Xóa">
                                        Xóa
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Xác nhận xóa</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Bạn có chắc chắn muốn xóa cấu hình <strong>@item.TenCauHinh</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@item.Id">
                                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
