@using QLBH_ThuySan.ViewModels
@using System.Globalization
@{
    ViewData["Title"] = "Thiết lập Tồn kho ban đầu";
    var isFinalized = ViewBag.IsFinalized as bool? ?? false;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold mb-3"><i class="fas fa-boxes text-primary me-2"></i> Thiết Lập Tồn Kho Ban Đầu</h2>
            <p class="text-muted">Tính năng này cho phép thiết lập số lượng tồn kho và giá vốn ban đầu trước khi hệ thống chính thức hoạt động.</p>
        </div>
    </div>

    @if (isFinalized)
    {
        <div class="alert alert-success shadow-sm mb-4">
            <h5 class="alert-heading"><i class="fas fa-check-circle me-2"></i> Trạng thái: Đã Chốt</h5>
            <p class="mb-0">Tồn kho ban đầu đã được chốt và ghi nhận vào hệ thống. Không thể sửa đổi thêm tại đây. Mọi thay đổi tiếp theo phải thực hiện qua Phiếu Nhập / Phiếu Xuất.</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="mb-0">Dữ Liệu Tồn Kho Ban Đầu Khởi Tạo</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Phiếu</th>
                                <th>Thời Gian</th>
                                <th>Sản Phẩm</th>
                                <th>Số Lượng</th>
                                <th>Giá Vốn</th>
                                <th>Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model is IEnumerable<QLBH_ThuySan.Models.ChiTietPhieuNhap> finalizedData)
                            {
                                foreach (var item in finalizedData)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@item.MaPhieu</span></td>
                                        <td>@(item.MaPhieuNavigation?.NgayNhap?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                        <td>
                                            <div class="fw-bold">@item.MaHangNavigation?.TenHang</div>
                                            <div class="small text-muted">@item.MaHang</div>
                                        </td>
                                        <td>@item.SoLuong?.ToString("N2", new CultureInfo("vi-VN"))</td>
                                        <td>@item.DonGiaNhap?.ToString("N0", new CultureInfo("vi-VN")) đ</td>
                                        <td>@item.ThanhTien?.ToString("N0", new CultureInfo("vi-VN")) đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm mb-4">
            <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i> Trạng thái: Bản Nháp (Chưa Chốt)</h5>
            <p class="mb-0">Bạn có thể thêm dữ liệu thủ công hoặc upload qua file Excel. Sau khi hoàn tất và kiểm tra kỹ, nhấn nút "Chốt Tồn Kho" bên dưới để hoàn thành.</p>
        </div>

        <div class="row g-4 mb-4">
            <!-- Khai Báo Thủ Công -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <h5 class="mb-0"><i class="fas fa-keyboard text-primary me-2"></i> Khai Báo Thủ Công</h5>
                    </div>
                    <div class="card-body">
                        <form id="formManual" class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Kho Vật Lý</label>
                                <select id="MaKho" name="MaKho" class="form-select" required>
                                    <option value="">-- Chọn Kho --</option>
                                    @if (ViewBag.Khos != null)
                                    {
                                        foreach (var kho in ViewBag.Khos)
                                        {
                                            <option value="@kho.MaKho">@kho.TenKho</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Hàng Hóa</label>
                                <select id="MaHang" name="MaHang" class="form-select" required>
                                    <option value="">-- Chọn Hàng --</option>
                                    @if (ViewBag.HangHoas != null)
                                    {
                                        foreach (var hh in ViewBag.HangHoas)
                                        {
                                            <option value="@hh.MaHang">@hh.TenHang (@hh.MaHang)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Số Lượng</label>
                                <input type="number" step="0.01" min="0" id="SoLuong" name="SoLuong" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Giá Vốn Ban Đầu</label>
                                <input type="number" step="1" min="0" id="GiaVon" name="GiaVon" class="form-control" required />
                            </div>
                            <div class="col-12 mt-4 text-end">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fas fa-plus me-1"></i> Thêm Vào Bản Nháp
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Import Hàng Loạt -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <h5 class="mb-0"><i class="fas fa-file-excel text-success me-2"></i> Import Hàng Loạt</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-4">Tải file mẫu Excel về, điền dữ liệu và upload lên hệ thống. Dữ liệu sẽ được cộng dồn vào bản nháp hiện tại.</p>
                        
                        <a href="@Url.Action("DownloadTemplate", "OpeningStock")" class="btn btn-outline-success mb-4 w-100">
                            <i class="fas fa-download me-2"></i> Tải File Mẫu (Template)
                        </a>

                        <form id="formUpload" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Chọn File Excel/CSV</label>
                                <input type="file" id="fileExcel" name="file" class="form-control" accept=".xlsx,.csv" required />
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-success px-4" id="btnUpload">
                                    <span class="spinner-border spinner-border-sm d-none me-1" id="uploadSpinner" role="status" aria-hidden="true"></span>
                                    <i class="fas fa-upload me-1" id="uploadIcon"></i> Tải Dữ Liệu Lên
                                </button>
                            </div>
                        </form>
                        <div id="uploadResult" class="mt-3" style="display:none;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng Dữ Liệu Nháp -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Chi Tiết Bản Nháp</h5>
                <button type="button" class="btn btn-danger px-4" id="btnFinalize">
                    <i class="fas fa-lock me-2"></i> Chốt Tồn Kho
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Kho</th>
                                <th>Mã Hàng</th>
                                <th>Tên Hàng Hóa</th>
                                <th class="text-end">Số Lượng</th>
                                <th class="text-end">Giá Vốn</th>
                                <th class="text-end">Thành Tiền (Tạm tính)</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model is List<OpeningStockDraftViewModel> drafts && drafts.Any())
                            {
                                foreach (var item in drafts)
                                {
                                    var thanhTien = (decimal)item.SoLuong * item.GiaVon;
                                    <tr>
                                        <td><span class="badge bg-info text-dark">@item.MaKho</span></td>
                                        <td>@item.MaHang</td>
                                        <td class="fw-bold">@item.TenHang</td>
                                        <td class="text-end">@item.SoLuong.ToString("N2", new CultureInfo("vi-VN"))</td>
                                        <td class="text-end">@item.GiaVon.ToString("N0", new CultureInfo("vi-VN")) đ</td>
                                        <td class="text-end fw-bold text-primary">@thanhTien.ToString("N0", new CultureInfo("vi-VN")) đ</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-draft" data-kho="@item.MaKho" data-hang="@item.MaHang">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu nháp</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Xử lý thêm thủ công
            $('#formManual').on('submit', function (e) {
                e.preventDefault();
                var data = {
                    MaKho: $('#MaKho').val(),
                    MaHang: $('#MaHang').val(),
                    SoLuong: parseFloat($('#SoLuong').val()),
                    GiaVon: parseFloat($('#GiaVon').val())
                };

                $.ajax({
                    url: '@Url.Action("AddDraft", "OpeningStock")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res.success) {
                            window.location.reload();
                        }
                    },
                    error: function (xhr) {
                        alert(xhr.responseText || 'Có lỗi xảy ra.');
                    }
                });
            });

            // Xử lý Upload file
            $('#formUpload').on('submit', function (e) {
                e.preventDefault();
                var file = $('#fileExcel')[0].files[0];
                if (!file) return;

                var formData = new FormData();
                formData.append('file', file);

                $('#btnUpload').prop('disabled', true);
                $('#uploadSpinner').removeClass('d-none');
                $('#uploadIcon').addClass('d-none');
                $('#uploadResult').hide();

                $.ajax({
                    url: '@Url.Action("UploadExcel", "OpeningStock")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            var html = `<div class="alert alert-success mt-2">Đã import thành công ${res.successCount} dòng.</div>`;
                            if (res.errors && res.errors.length > 0) {
                                html += `<div class="alert alert-danger mt-2"><strong>Các lỗi phát sinh:</strong><ul>`;
                                res.errors.forEach(err => html += `<li>${err}</li>`);
                                html += `</ul></div>`;
                            }
                            $('#uploadResult').html(html).show();
                            setTimeout(() => { window.location.reload(); }, 2000);
                        }
                    },
                    error: function (xhr) {
                        $('#uploadResult').html(`<div class="alert alert-danger mt-2">${xhr.responseText || 'Lỗi server'}</div>`).show();
                    },
                    complete: function () {
                        $('#btnUpload').prop('disabled', false);
                        $('#uploadSpinner').addClass('d-none');
                        $('#uploadIcon').removeClass('d-none');
                    }
                });
            });

            // Xóa file nháp
            $('.btn-delete-draft').on('click', function () {
                var maKho = $(this).data('kho');
                var maHang = $(this).data('hang');
                if (confirm('Xóa sản phẩm ' + maHang + ' khỏi kho ' + maKho + '?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteDraft", "OpeningStock")',
                        type: 'POST',
                        data: { maKho: maKho, maHang: maHang },
                        success: function (res) {
                            if (res.success) {
                                window.location.reload();
                            }
                        }
                    });
                }
            });

            // Chốt Tồn Kho
            $('#btnFinalize').on('click', function () {
                if (confirm('BẠN CHẮC CHẮN MUỐN CHỐT TỒN KHO? Hành động này không thể hoàn tác và sẽ đóng tính năng này lại.')) {
                    var btn = $(this);
                    btn.prop('disabled', true);
                    btn.html('<i class="fas fa-spinner fa-spin me-2"></i> Đang xử lý...');

                    $.ajax({
                        url: '@Url.Action("FinalizeOpeningStock", "OpeningStock")',
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                alert('Chốt tồn kho thành công!');
                                window.location.reload();
                            }
                        },
                        error: function (xhr) {
                            alert(xhr.responseText || 'Có lỗi xảy ra.');
                            btn.prop('disabled', false);
                            btn.html('<i class="fas fa-lock me-2"></i> Chốt Tồn Kho');
                        }
                    });
                }
            });
        });
    </script>
}
