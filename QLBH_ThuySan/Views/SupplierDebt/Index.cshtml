@model IEnumerable<QLBH_ThuySan.Models.NhaCungCap>

@{
    ViewData["Title"] = "Công Nợ Đầu Vào (Nhà Cung Cấp)";
}

<h2>Theo Dõi Công Nợ Đầu Vào (Nhà Cung Cấp)</h2>

<div class="row mb-3">
    <div class="col-12">
        <div class="alert alert-info">
             <i class="bi bi-info-circle"></i> Quản lý công nợ với các Nhà cung cấp dựa trên các Phiếu Nhập hàng.
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Mã NCC</th>
                <th>Tên Nhà Cung Cấp</th>
                <th>Số Điện Thoại</th>
                <th>Điều Khoản Nợ</th>
                <th>Dư Nợ Hiện Tại (Tính Nhập)</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td><span class="badge bg-secondary">@item.MaDoiTuong</span></td>
                    <td class="fw-bold">@item.TenDoiTuong</td>
                    <td>@item.SoDienThoai</td>
                    <td>
                        @if((item.SoNgayDuocNo ?? 0) > 0)
                        {
                            <span class="badge bg-info text-dark">@item.SoNgayDuocNo ngày</span>
                        }
                        else 
                        {
                            <span class="badge bg-secondary">Thanh toán ngay</span>
                        }
                    </td>
                    <td class="text-danger fw-bold">@string.Format("{0:N0}", item.DuNoLuyKe ?? 0) đ</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.MaDoiTuong" class="btn btn-sm btn-outline-primary">
                            Xem Chi Tiết Nhập
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
