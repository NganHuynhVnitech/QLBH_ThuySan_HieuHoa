
@model IEnumerable<QLBH_ThuySan.Models.DoiTuongChiPhi>

@{
    ViewData["Title"] = "Quản Lý Đối Tượng Chi Phí";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1>Quản Lý Đối Tượng Chi Phí</h1>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm Mới
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đối Tượng</th>
                        <th>Tên Đối Tượng</th>
                        <th class="text-end">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 0; }
                    @foreach (var item in Model)
                    {
                        index++;
                        <tr>
                            <td><span class="badge bg-secondary">@item.MaDoiTuong</span></td>
                            <td class="fw-bold">@item.TenDoiTuong</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.MaDoiTuong" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        Sửa
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@index" title="Xóa">
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Generate Modals outside the table to ensure valid HTML and prevent z-index/display issues *@
@{ int modalIndex = 0; }
@foreach (var item in Model)
{
    modalIndex++;
    <!-- Delete Modal for @item.MaDoiTuong -->
    <div class="modal fade" id="deleteModal-@modalIndex" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Xác nhận xóa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    Bạn có chắc chắn muốn xóa đối tượng <strong>@item.TenDoiTuong</strong> (@item.MaDoiTuong)?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <form asp-action="Delete" asp-route-id="@item.MaDoiTuong">
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
