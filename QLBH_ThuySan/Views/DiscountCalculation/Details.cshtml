@model QLBH_ThuySan.Models.PhieuTinhChietKhau

@{
    ViewData["Title"] = "Kết Quả Tính Chiết Khấu";
    var lookup = ViewBag.Names as Dictionary<string, string>;
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Kết Quả Tính: <span class="text-primary">@Model.MaPhieuTinh</span></h1>
            <p class="text-muted">Kỳ: @Model.TuNgay?.ToString("dd/MM/yyyy") - @Model.DenNgay?.ToString("dd/MM/yyyy") | Đối Tượng: @Model.LoaiDoiTuong</p>
        </div>
        <div class="col-md-4 text-end align-self-center">
            <a asp-action="Index" class="btn btn-secondary">Quay Lại</a>
             <!-- Export/Print options could go here -->
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Bảng Kê Chi Tiết</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Đối Tượng</th>
                        <th>Tên Đối Tượng</th>
                        <th class="text-end">Tổng Tiền CK</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.BangKeChietKhaus.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center">Không có dữ liệu chiết khấu nào được tính toán.</td></tr>
                    }
                    @foreach (var item in Model.BangKeChietKhaus)
                    {
                        var name = lookup != null && item.MaDoiTuong != null && lookup.ContainsKey(item.MaDoiTuong) ? lookup[item.MaDoiTuong] : item.MaDoiTuong;
                        <tr>
                            <td>@item.MaDoiTuong</td>
                            <td class="fw-bold">@name</td>
                            <td class="text-end fw-bold text-success">@string.Format("{0:N0}", item.TongTien)</td>
                            <td>
                                <span class="badge bg-warning text-dark">@item.TrangThai</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
