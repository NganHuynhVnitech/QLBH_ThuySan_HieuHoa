@model QLBH_ThuySan.Models.PhieuTinhChietKhau

@{
    ViewData["Title"] = "Kết Quả Tính Chiết Khấu";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Phiếu Chiết Khấu: <span class="text-primary">@Model.MaPhieuTinh</span></h1>
            <p class="text-muted">
                Đối Tượng: <strong>@ViewBag.PartnerName</strong> | 
                Kỳ: @Model.TuNgay?.ToString("dd/MM/yyyy") - @Model.DenNgay?.ToString("dd/MM/yyyy")
            </p>
        </div>
        <div class="col-md-4 text-end align-self-center">
            <h4 class="text-primary fw-bold">Phải TT: @string.Format("{0:N0}", Model.SoPhaiThanhToan) đ</h4>
            <h4 class="text-success fw-bold">Đã TT: @string.Format("{0:N0}", Model.SoDaThanhToan) đ</h4>
            <h4 class="text-danger fw-bold">Còn Nợ: @string.Format("{0:N0}", Model.SoChuaThanhToan) đ</h4>
            <span class="badge bg-warning text-dark fs-6">@Model.TrangThai</span>
            <div class="mt-2">
                <a asp-action="Print" asp-route-id="@Model.MaPhieuTinh" class="btn btn-secondary me-2" target="_blank">
                    <i class="bi bi-printer"></i> In Phiếu
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay Lại
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Chi Tiết Sản Phẩm & Mức Chiết Khấu</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Hàng</th>
                            <th>Tên Hàng</th>
                            <th class="text-center">Số Lượng</th>
                            <th>Nội Dung / Quy Tắc</th>
                            <th class="text-end">Đơn Giá CK</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ChiTietPhieuTinhs.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center py-4">Không có dữ liệu chiết khấu nào.</td></tr>
                        }
                        @foreach (var item in Model.ChiTietPhieuTinhs)
                        {
                            <tr>
                                <td>@item.MaHang</td>
                                <td class="fw-bold">@item.MaHangNavigation?.TenHang</td>
                                <td class="text-center">@item.SoLuong</td>
                                <td>@item.NoiDung</td>
                                <td class="text-end">@string.Format("{0:N0}", item.SoTienChietKhau)</td>
                                <td class="text-end fw-bold text-success">@string.Format("{0:N0}", item.ThanhTien)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

