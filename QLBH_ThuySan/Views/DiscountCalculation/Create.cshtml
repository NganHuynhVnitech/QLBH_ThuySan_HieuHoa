@{
    ViewData["Title"] = "Lập Phiếu Chiết Khấu";
}

<style>
    .step-header { font-weight: bold; color: #0d6efd; margin-bottom: 15px; border-bottom: 2px solid #e9ecef; padding-bottom: 5px; }
    .receipt-list { max-height: 300px; overflow-y: auto; font-size: 0.9em; }
</style>

<div class="row mb-3">
    <div class="col-12">
        <h1>Lập Phiếu Chiết Khấu (Ad-hoc)</h1>
        <p class="text-muted">Tính chiết khấu theo từng mặt hàng cho Nhà cung cấp hoặc Khách hàng.</p>
    </div>
</div>

<div class="row">
    <!-- Left Panel: Configuration -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <!-- Step 1-3: Target & Date -->
                <h5 class="step-header">1. Thông Tin Chung</h5>
                <form id="mainForm">
                    <div class="mb-3">
                        <label class="form-label">Khoảng Thời Gian</label>
                        <div class="input-group">
                            <input type="date" id="fromDate" class="form-control" value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")">
                            <span class="input-group-text">-</span>
                            <input type="date" id="toDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Loại Đối Tượng</label>
                        <select id="typeSelect" class="form-select">
                            <option value="NCC">Nhà Cung Cấp (Nhập)</option>
                            <option value="KHACH">Khách Hàng (Xuất)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Chọn Đối Tượng</label>
                        <div class="input-group">
                            <input type="text" id="partnerSearch" class="form-control" placeholder="Tìm tên hoặc mã..." autocomplete="off">
                            <input type="hidden" id="partnerId">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                        </div>
                        <div id="partnerResults" class="list-group position-absolute w-100" style="z-index: 1000; display:none;"></div>
                    </div>
                </form>

                <!-- Step 4: Product -->
                <h5 class="step-header mt-4">2. Chọn Mặt Hàng</h5>
                <div class="mb-3">
                     <div class="input-group">
                        <input type="text" id="productSearch" class="form-control" placeholder="Tìm hàng hóa..." autocomplete="off" disabled>
                        <input type="hidden" id="productId">
                         <span class="input-group-text"><i class="bi bi-box"></i></span>
                    </div>
                     <div id="productResults" class="list-group position-absolute w-100" style="z-index: 1000; display:none;"></div>
                </div>

                <!-- Step 5: Rule -->
                <h5 class="step-header mt-4">3. Quy Tắc Chiết Khấu</h5>
                <div class="mb-3">
                    <div class="form-check form-check-inline">
                         <input class="form-check-input" type="radio" name="ruleType" id="ruleFixed" value="Fixed" checked>
                         <label class="form-check-label" for="ruleFixed">Cố Định (đ/kg)</label>
                    </div>
                    <div class="form-check form-check-inline">
                         <input class="form-check-input" type="radio" name="ruleType" id="ruleTiered" value="Tiered">
                         <label class="form-check-label" for="ruleTiered">Theo Bậc Thang</label>
                    </div>
                </div>

                <!-- Rule Inputs -->
                <div id="fixedInput" class="mb-3">
                    <label class="form-label">Số Tiền Chiết Khấu (đ/ĐVT)</label>
                    <input type="number" id="fixedRate" class="form-control" placeholder="VD: 500">
                </div>

                <div id="tieredInput" class="mb-3" style="display:none;">
                    <label class="form-label">Cấu Hình Bậc (Slượng -> Giá/ĐVT)</label>
                    <table class="table table-sm table-bordered" id="tierTable">
                        <thead>
                            <tr>
                                <th>Từ</th>
                                <th>Đến</th>
                                <th>Giá (đ)</th>
                                <th>Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Rows -->
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-primary w-100" id="btnAddTier">+ Thêm Bậc</button>
                    <small class="text-muted d-block mt-1">* Bậc cuối cùng có thể để "Đến" trống (= vô cùng)</small>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="button" id="btnCalculate" class="btn btn-primary py-2" disabled>
                        <i class="bi bi-calculator"></i> TÍNH TOÁN CHIẾT KHẤU
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Panel: Data & Result -->
    <div class="col-md-7">
        <!-- Receipt List -->
        <div class="card shadow-sm mb-3">
             <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Dữ Liệu Giao Dịch</h5>
                    <span class="badge bg-primary fs-6" id="totalQtyBadge">Tổng SL: 0</span>
                </div>
            </div>
            <div class="card-body p-0 receipt-list">
                <table class="table table-striped table-hover mb-0" id="receiptTable">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Ngày</th>
                            <th>Số Phiếu</th>
                            <th>Mặt Hàng</th>
                            <th class="text-end">Số Lượng</th>
                        </tr>
                    </thead>
                    <tbody id="receiptBody">
                        <tr><td colspan="4" class="text-center text-muted py-5">Vui lòng chọn Đối tượng & Mặt hàng để tải dữ liệu</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Result -->
        <div id="resultSection" class="card shadow-sm border-success mb-3" style="display:none;">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Kết Quả Tính Toán</h5>
            </div>
            <div class="card-body text-center">
                <h3 class="display-6 fw-bold text-success" id="finalAmount">0 đ</h3>
                <p class="text-muted" id="calculationLog">Chi tiết tính toán...</p>
                <hr>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary" onclick="$('#resultSection').hide()">Hủy</button>
                    <button type="button" id="btnSave" class="btn btn-primary px-4">Lưu Phiếu</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let selectedPartner = null;
            let selectedProduct = null;
            let transactionData = [];

            // --- 1. Partner Search ---
            $('#partnerSearch').on('input', function() {
                var term = $(this).val();
                var type = $('#typeSelect').val();
                if (term.length < 2) { $('#partnerResults').hide(); return; }

                var url = type === 'NCC' ? '/Supplier/SearchJson' : '/Customer/SearchJson';
                $.get(url, { term: term }, function(data) {
                    var html = '';
                    if (data.length === 0) html = '<div class="list-group-item">Không tìm thấy</div>';
                    else {
                        data.forEach(function(item) {
                            html += `<a href="#" class="list-group-item list-group-item-action partner-item" data-id="${item.maDoiTuong}" data-name="${item.tenDoiTuong}">
                                        <strong>${item.tenDoiTuong}</strong> <br> <small>${item.maDoiTuong}</small>
                                     </a>`;
                        });
                    }
                    $('#partnerResults').html(html).show();
                });
            });

            $(document).on('click', '.partner-item', function(e) {
                e.preventDefault();
                $('#partnerId').val($(this).data('id'));
                $('#partnerSearch').val($(this).data('name'));
                $('#partnerResults').hide();
                selectedPartner = { id: $(this).data('id'), name: $(this).data('name') };
                $('#productSearch').prop('disabled', false).focus();
            });

            // --- 2. Product Search ---
            $('#productSearch').on('input', function() {
                var term = $(this).val();
                if (term.length < 2) { $('#productResults').hide(); return; }
                
                // Assuming we have a Product Search API or generic one. Currently reuse Inventory/HangHoa?
                // Let's assume a generic search available, or we mock it. System likely has one.
                // We'll use a simple mock-like fetch for now if no specific "SearchProduct" exists, 
                // OR better: use existing Controller logic if available.
                // Let's use `Supplier/SearchJson` pattern but for Products. 
                // Actually, let's create a quick API in Controller or use `Inventory/Search`.
                // For now, I'll assume we can add `SearchProducts` to DiscountController.
                
                $.get('/DiscountCalculation/SearchProduct', { term: term }, function(data) {
                    var html = '';
                    if (!data || data.length === 0) html = '<div class="list-group-item">Không tìm thấy</div>';
                    else {
                        data.forEach(function(item) {
                            html += `<a href="#" class="list-group-item list-group-item-action product-item" data-id="${item.maHang}" data-name="${item.tenHang}">
                                        <strong>${item.tenHang}</strong> <br> <small>${item.maHang}</small>
                                     </a>`;
                        });
                    }
                    $('#productResults').html(html).show();
                });
            });

             $(document).on('click', '.product-item', function(e) {
                e.preventDefault();
                $('#productId').val($(this).data('id'));
                $('#productSearch').val($(this).data('name'));
                $('#productResults').hide();
                selectedProduct = { id: $(this).data('id'), name: $(this).data('name') };
                loadReceipts();
            });

            // --- 3. Load Receipts ---
            function loadReceipts() {
                if(!selectedPartner || !selectedProduct) return;
                
                $('#receiptBody').html('<tr><td colspan="4" class="text-center">Đang tải...</td></tr>');
                
                $.get('/DiscountCalculation/GetProductTransactions', {
                    type: $('#typeSelect').val(),
                    partnerId: selectedPartner.id,
                    productId: selectedProduct.id,
                    fromDate: $('#fromDate').val(),
                    toDate: $('#toDate').val()
                }, function(data) {
                    transactionData = data;
                    renderReceipts(data);
                    $('#btnCalculate').prop('disabled', data.length === 0);
                });
            }

            function renderReceipts(data) {
                var html = '';
                var total = 0;
                if(data.length === 0) {
                     html = '<tr><td colspan="4" class="text-center text-warning">Không có giao dịch nào</td></tr>';
                } else {
                    data.forEach(item => {
                        total += item.soLuong;
                        html += `<tr>
                                    <td>${new Date(item.ngay).toLocaleDateString('vi-VN')}</td>
                                    <td>${item.maPhieu}</td>
                                    <td>${item.tenHang}</td>
                                    <td class="text-end fw-bold">${item.soLuong.toLocaleString()}</td>
                                 </tr>`;
                    });
                }
                $('#receiptBody').html(html);
                $('#totalQtyBadge').text('Tổng SL: ' + total.toLocaleString());
            }

            // --- 4. Rules UI ---
            $('input[name="ruleType"]').change(function() {
                if(this.value === 'Fixed') {
                    $('#fixedInput').show();
                    $('#tieredInput').hide();
                } else {
                    $('#fixedInput').hide();
                    $('#tieredInput').show();
                    if($('#tierTable tbody tr').length === 0) addTierRow();
                }
            });

            $('#btnAddTier').click(addTierRow);

            function addTierRow() {
                var html = `<tr>
                                <td><input type="number" class="form-control form-control-sm tier-from" value="0"></td>
                                <td><input type="number" class="form-control form-control-sm tier-to"></td>
                                <td><input type="number" class="form-control form-control-sm tier-price"></td>
                                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="$(this).closest('tr').remove()">X</button></td>
                            </tr>`;
                $('#tierTable tbody').append(html);
            }

            // --- 5. Calculate ---
            $('#btnCalculate').click(function() {
                var totalQty = parseFloat($('#totalQtyBadge').text().replace(/\D/g,''));
                if(totalQty <= 0) return;

                var ruleType = $('input[name="ruleType"]:checked').val();
                var resultAmount = 0;
                var log = '';

                if(ruleType === 'Fixed') {
                    var rate = parseFloat($('#fixedRate').val()) || 0;
                    resultAmount = totalQty * rate;
                    log = `Cố định: ${totalQty.toLocaleString()} x ${rate.toLocaleString()} đ`;
                } else {
                    // Tiered Calculation
                    // Logic: Apply buckets or progressive? 
                    // User Request: "0-100 ck 500, 101-200 ck 600". 
                    // Usually this implies splitting the quantity (Progressive) like Income Tax, OR Flat rate based on bracket.
                    // "chiết khấu theo bậc" often means Volume Based Volume Pricing (if total > 100, whole qty gets 600) OR Progressive (first 100 get 500, next 100 get 600).
                    // Given the prompt "chi tiết từng bậc", progressive is safer/more common in advanced systems, BUT "Volume Discount" is clearer.
                    // Let's implement PROGRESSIVE (Splitting quantity) as it fits "details per tier".
                    
                    var tiers = [];
                    $('#tierTable tbody tr').each(function() {
                        var from = parseFloat($(this).find('.tier-from').val()) || 0;
                        var to = parseFloat($(this).find('.tier-to').val()) || Infinity;
                        var price = parseFloat($(this).find('.tier-price').val()) || 0;
                        tiers.push({from, to, price});
                    });
                    
                    // Sort
                    tiers.sort((a,b) => a.from - b.from);

                    var remaining = totalQty;
                    var breakdown = [];
                    
                    // Progressive Logic
                    // Example: T1 0-100@500, T2 101-200@600. Qty 150.
                    // 100 * 500 + 50 * 600.
                    
                    // Ensure contiguous? Let's assume user enters valid 0-100, 101-200.
                    // Actually simpler to just use From/To as bounds.
                    
                    tiers.forEach(t => {
                        if(remaining <= 0) return;
                        // Determine capacity of this tier
                        // Wait, "From 0 to 100" means capacity 100 (if inclusive/exclusive logic holds).
                        // Let's assume standard ranges.
                        // Capacity = (To - From) + 1? Or just To - From?
                        // Let's use simpler logic: 
                        // Range size = (t.to === Infinity) ? Infinity : (t.to - t.from); 
                        // BUT user might enter 0-100, then 101-200. The gap 100-101 is ambiguous.
                        // Let's assume user means "Qty falling in this chunk". 
                        
                        // Let's try simple "Bucket" logic first? NO, user said "chi tiết từng bậc".
                        // Let's do Progressive.
                        
                        // Current logic: We need to fill buckets.
                        // Correct logic usually: 
                        // Tier 1: 0 - 100. Cap = 100.
                        // Tier 2: 101 - 200. Cap = 100.
                        // We need to map [0, totalQty] onto these ranges.
                        
                        // Simplified: Overlap of [0, TotalQty] and [TierFrom, TierTo].
                        var rangeStart = t.from;
                        var rangeEnd = t.to === Infinity ? Number.MAX_VALUE : t.to;
                        
                        // We want the quantity intersection of [0, totalQty] (Wait, the tiers define the segments of the total quantity).
                        // Usually Tiers start at 0.
                        // Segments: [0, 100], [100, 200]...
                        // Intersection of [0, TotalQty] with [t.from, t.to].
                        // Size = Max(0, Min(TotalQty, t.to) - Max(0, t.from)); 
                        // Wait, if Tier is 101-200. t.from=101. 
                        // Should be: Size = Max(0, Min(TotalQty, t.to) - Max(0, t.from - 1?? or t.from)).
                        // If user inputs 0-100, 101-200. 
                        // Qty 150.
                        // T1 (0-100): Min(150, 100) - Max(0, 0) = 100. Correct.
                        // T2 (101-200): Min(150, 200) - Max(0, 101) = 150 - 101 = 49. (Should be 50).
                        // The user input 101 is inclusive. So start is 101. Ideally we treat it as >100.
                        // Let's just blindly use the intersection math but -1 if >0? Too messy.
                        
                        // Let's use logic: Amount in Tier = Min(Remaining, TierCapacity).
                        // TierCapacity = t.to - t.from (if we normalize 101 -> 100).
                        
                        // Let's stick to Intersection:
                        // EffectiveFrom = (t.from == 0) ? 0 : t.from - 1; // Hack for "101"
                        // Or just trust user input 0-100, 100-200 (Continuous).
                        // UI Placeholder says "0-100".
                        
                        var effectiveStart = t.from; 
                        var effectiveEnd = t.to;
                        
                        // Handle "101" style gaps by assuming T2 starts where T1 ended? 
                        // No, let's just use simple intersection and assume user inputs continuous ranges like 0-100, 100-200.
                        // If user does 0-100, 101-200, we miss 1 unit.
                        // Let's just use Intersection logic:
                        // QtyContribution = Math.max(0, Math.min(totalQty, effectiveEnd) - effectiveStart);
                        // If user enters 101, contribution is Min(150, 200) - 101 = 49.
                        // We will allow the user to see the calc log.
                        
                        var contrib = Math.max(0, Math.min(totalQty, effectiveEnd) - Math.max(0, effectiveStart));
                         // Fix for 0 base: If from=0, start=0.
                         // Only if contiguous.
                        
                        if(contrib > 0) {
                            resultAmount += contrib * t.price;
                            breakdown.push(`${contrib} x ${t.price}`);
                        }
                    });
                    log = `Bậc thang: ${breakdown.join(' + ')}`;
                }

                $('#finalAmount').text(resultAmount.toLocaleString('en-US') + ' đ');
                $('#calculationLog').text(log);
                $('#resultSection').show();
                
                // Scroll to result
                $('html, body').animate({ scrollTop: $("#resultSection").offset().top }, 500);
            });

            // --- 6. Save ---
            $('#btnSave').click(function() {
                var totalQty = parseFloat($('#totalQtyBadge').text().replace(/\D/g,''));
                var amount = parseFloat($('#finalAmount').text().replace(/\D/g,''));
                var ruleType = $('input[name="ruleType"]:checked').val();
                
                var ruleDesc = $('#calculationLog').text();
                
                var payload = {
                    Type: $('#typeSelect').val(),
                    PartnerId: $('#partnerId').val(),
                    FromDate: $('#fromDate').val(),
                    ToDate: $('#toDate').val(),
                    // Flattened Item
                    Items: [{
                        IsSelected: true,
                        MaHang: selectedProduct.id,
                        TotalQty: totalQty,
                        RuleType: ruleType,
                        FixedRate: 0, // Handled in CalcAmount
                        CalculatedAmount: amount, 
                        RuleDescription: ruleDesc
                    }]
                };

                $.ajax({
                    url: '/DiscountCalculation/Save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if(res.success) {
                            window.location.href = '/DiscountCalculation/Details/' + res.id;
                        }
                    },
                    error: function(err) {
                        alert('Lỗi: ' + err.responseText);
                    }
                });
            });
        });
    </script>
}
