@model QLBH_ThuySan.Models.ViewModels.DiscountListViewModel

@{
    ViewData["Title"] = "Quản Lý Chiết Khấu";
}

<div class="row pt-4 mb-4">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold">Quản Lý Chiết Khấu</h1>
        <p class="text-muted">Tính toán, đối soát và thanh toán các khoản chiết khấu thương mại theo kỳ.</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Quay Lại
        </a>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-calculator"></i> Lập Phiếu Mới
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-uppercase">Từ Ngày</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-uppercase">Đến Ngày</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-uppercase">Loại</label>
                    <select name="type" class="form-select form-select-sm" asp-for="Type" onchange="this.form.submit()">
                        <option value="">-- Tất Cả --</option>
                        <option value="NCC">Nhà Cung Cấp</option>
                        <option value="KHACH">Khách Hàng</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-uppercase">Trạng Thái</label>
                    <select name="status" class="form-select form-select-sm" asp-for="Status" onchange="this.form.submit()">
                        <option value="">-- Tất Cả --</option>
                        <option value="Chưa Thanh Toán">Chưa Thanh Toán</option>
                        <option value="Đã Thanh Toán">Đã Thanh Toán</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-uppercase">Đối Tượng / Nội Dung</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Tìm tên, mã, quy tắc..." value="@Model.SearchTerm">
                    </div>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100" title="Tìm Kiếm">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        @{
                            string GetSortUrl(string column)
                            {
                                string nextOrder = (Model.SortColumn == column && Model.SortOrder == "asc") ? "desc" : "asc";
                                return Url.Action("Index", new
                                {
                                    searchTerm = Model.SearchTerm,
                                    status = Model.Status,
                                    type = Model.Type,
                                    fromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
                                    toDate = Model.ToDate?.ToString("yyyy-MM-dd"),
                                    ruleSearch = Model.RuleSearch,
                                    periodFrom = Model.PeriodFrom?.ToString("yyyy-MM-dd"),
                                    periodTo = Model.PeriodTo?.ToString("yyyy-MM-dd"),
                                    paymentFrom = Model.PaymentFrom?.ToString("yyyy-MM-dd"),
                                    paymentTo = Model.PaymentTo?.ToString("yyyy-MM-dd"),
                                    sortColumn = column,
                                    sortOrder = nextOrder
                                }) ?? "#";
                            }

                            string GetSortIcon(string column)
                            {
                                if (Model.SortColumn != column) return "bi-arrow-down-up opacity-25";
                                return Model.SortOrder == "asc" ? "bi-sort-up text-primary" : "bi-sort-down text-primary";
                            }
                        }
                        <th class="ps-3 small fw-bold text-uppercase"><a href="@GetSortUrl("MaPhieu")" class="text-decoration-none text-dark">Mã Phiếu <i class="bi @GetSortIcon("MaPhieu")"></i></a></th>
                        <th class="small fw-bold text-uppercase">Nội Dung</th>
                        <th class="small fw-bold text-uppercase text-center">Ngày Tạo</th>
                        <th class="small fw-bold text-uppercase">Đối Tượng</th>
                        <th class="small fw-bold text-uppercase text-end">Phải TT</th>
                        <th class="small fw-bold text-uppercase text-end">Đã TT</th>
                        <th class="small fw-bold text-uppercase text-end">Còn Nợ</th>
                        <th class="small fw-bold text-uppercase text-center">Trạng Thái</th>
                        <th class="text-center pe-3 small fw-bold text-uppercase">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="9" class="text-center py-4 text-muted small">Không tìm thấy dữ liệu phù hợp.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3"><span class="badge bg-light text-dark border">@item.MaPhieuTinh</span></td>
                            <td>
                                <div class="fw-bold">@item.TenPhieu</div>
                                <div class="small text-muted fst-italic text-truncate" style="max-width:200px">@item.QuyTacChietKhau</div>
                            </td>
                            <td class="text-center">@item.NgayTao.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="fw-bold">@item.TenDoiTuong</div>
                                <span class="badge @(item.LoaiDoiTuong == "NCC" ? "bg-info-subtle text-info border border-info" : "bg-warning-subtle text-warning border border-warning") small">
                                    @(item.LoaiDoiTuong == "NCC" ? "Nhà Cung Cấp" : "Khách Hàng")
                                </span>
                            </td>
                            <td class="text-end fw-bold text-primary">@string.Format("{0:N0}", item.SoPhaiThanhToan)</td>
                            <td class="text-end text-success small">@string.Format("{0:N0}", item.SoDaThanhToan)</td>
                            <td class="text-end fw-bold text-danger">@string.Format("{0:N0}", item.SoChuaThanhToan)</td>
                            <td class="text-center">
                                @if (item.TrangThai?.Equals("Đã Thanh Toán", StringComparison.OrdinalIgnoreCase) == true)
                                { <span class="badge bg-success">Đã Xong</span> }
                                else if (item.TrangThai?.Equals("Thanh Toán Một Phần", StringComparison.OrdinalIgnoreCase) == true)
                                { <span class="badge bg-warning text-dark">Một Phần</span> }
                                else
                                { <span class="badge bg-light text-muted border">Chờ Chi</span> }
                            </td>
                            <td class="text-center pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.MaPhieuTinh" class="btn btn-outline-info" title="Xem Chi Tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (item.SoChuaThanhToan > 0)
                                    {
                                        <button type="button" class="btn btn-primary" title="Thanh Toán" onclick="openPayModal('@item.MaPhieuTinh', @(item.SoChuaThanhToan))">
                                            <i class="bi bi-cash-coin"></i>
                                        </button>
                                    }
                                    <a asp-action="Print" asp-route-id="@item.MaPhieuTinh" class="btn btn-outline-secondary" title="In Phiếu" target="_blank">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.MaPhieuTinh" method="post" style="display:inline;" onsubmit="return confirm('Xóa phiếu chiết khấu này?')">
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thanh Toán (Reused from Details) -->
<div class="modal fade" id="payBillModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content text-dark">
            <form id="payForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Thanh Toán Phiếu <span id="payMaPhieuDisplay"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-start">
                    <input type="hidden" id="payMaPhieu" name="id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền chưa thanh toán:</label>
                        <div class="input-group">
                            <input type="text" id="payRemainingDisplay" class="form-control bg-light" readonly />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền thanh toán:</label>
                        <div class="input-group">
                            <input type="text" class="form-control border-success fw-bold" id="payAmountDisplay" required />
                            <input type="hidden" id="payAmount" name="amount" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <div class="form-text mt-2 text-muted">
                            <i class="bi bi-info-circle"></i> Mặc định là thanh toán toàn bộ phần còn lại.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Diễn Giải</label>
                        <textarea class="form-control" id="payDienGiai" name="dienGiai" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" id="btnConfirmPay" class="btn btn-success px-4">
                        <i class="bi bi-check-circle"></i> Xác nhận thanh toán
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPayModal(id, remaining) {
            $('#payMaPhieuDisplay').text(id);
            $('#payMaPhieu').val(id);
            $('#payRemainingDisplay').val(formatNumber(remaining));
            
            $('#payAmount').val(remaining);
            $('#payAmountDisplay').val(formatNumber(remaining));
            $('#payDienGiai').val('Thanh toán chiết khấu phiếu ' + id);

            var modal = new bootstrap.Modal(document.getElementById('payBillModal'));
            modal.show();
        }

        $('#payAmountDisplay').on('input', function() {
            var value = $(this).val().replace(/\./g, '');
            if (value === "") {
                $('#payAmount').val(0);
                return;
            }
            $(this).val(formatNumber(value));
            $('#payAmount').val(value);
        });

        $('#payForm').on('submit', function(e) {
            e.preventDefault();
            
            const id = $('#payMaPhieu').val();
            const amount = $('#payAmount').val();
            const dienGiai = $('#payDienGiai').val();

            if (parseFloat(amount) <= 0) {
                alert('Vui lòng nhập số tiền hợp lệ.');
                return;
            }

            $('#btnConfirmPay').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Đang xử lý...');

            $.post('/DiscountCalculation/Pay', { id: id, amount: amount, dienGiai: dienGiai }, function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + res.message);
                    $('#btnConfirmPay').prop('disabled', false).html('<i class="bi bi-check-circle"></i> Xác nhận thanh toán');
                }
            }).fail(function(err) {
                alert('Lỗi hệ thống khi thanh toán.');
                $('#btnConfirmPay').prop('disabled', false).html('<i class="bi bi-check-circle"></i> Xác nhận thanh toán');
            });
        });
    </script>
}

