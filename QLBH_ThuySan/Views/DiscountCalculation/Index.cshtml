@model QLBH_ThuySan.Models.ViewModels.DiscountListViewModel

@{
    ViewData["Title"] = "Quản Lý Chiết Khấu";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1>Quản Lý Chiết Khấu</h1>
        <p class="text-muted">Theo dõi và quản lý các phiếu tính chiết khấu cho Khách Hàng và Nhà Cung Cấp.</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Lập Phiếu Mới
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0 text-primary"><i class="bi bi-funnel"></i> Bộ Lọc Tìm Kiếm</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <!-- Row 1 -->
                <div class="col-md-3">
                    <label class="form-label">Từ Ngày (Tạo)</label>
                    <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến Ngày (Tạo)</label>
                    <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Loại Đối Tượng</label>
                    <select name="type" class="form-select" asp-for="Type">
                        <option value="">-- Tất Cả --</option>
                        <option value="NCC">Nhà Cung Cấp</option>
                        <option value="KHACH">Khách Hàng</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Trạng Thái</label>
                    <select name="status" class="form-select" asp-for="Status">
                        <option value="">-- Tất Cả --</option>
                        <option value="Chưa thanh toán">Chưa thanh toán</option>
                        <option value="Đã thanh toán">Đã thanh toán</option>
                    </select>
                </div>

                <!-- Row 2 -->
                <div class="col-md-3">
                    <label class="form-label">Kỳ Tính (Từ)</label>
                    <input type="date" name="periodFrom" class="form-control" value="@Model.PeriodFrom?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Kỳ Tính (Đến)</label>
                    <input type="date" name="periodTo" class="form-control" value="@Model.PeriodTo?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Quy Tắc Chiết Khấu</label>
                    <input type="text" name="ruleSearch" class="form-control" placeholder="Tìm nội dung quy tắc..." value="@Model.RuleSearch">
                </div>

                <!-- Row 3 -->
                <div class="col-md-3">
                    <label class="form-label">Ngày Thanh Toán (Từ)</label>
                    <input type="date" name="paymentFrom" class="form-control" value="@Model.PaymentFrom?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ngày Thanh Toán (Đến)</label>
                    <input type="date" name="paymentTo" class="form-control" value="@Model.PaymentTo?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đối Tượng (Tên/Mã)</label>
                    <div class="input-group">
                         <span class="input-group-text"><i class="bi bi-search"></i></span>
                         <input type="text" name="searchTerm" class="form-control" placeholder="Tên hoặc Mã..." value="@Model.SearchTerm">
                    </div>
                </div>

                <!-- Actions -->
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 me-2"><i class="bi bi-search"></i> Tìm Kiếm</button>
                    <a asp-action="Index" class="btn btn-secondary">Đặt Lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã Phiếu</th>
                        <th>Ngày Tạo</th>
                        <th>Kỳ Tính Toán</th>
                        <th>Loại</th>
                        <th>Đối Tượng</th>
                        <th>Quy Tắc (Tóm Tắt)</th>
                        <th>Ngày Thanh Toán</th>
                        <th class="text-end">Tổng Tiền CK</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="9" class="text-center py-4 text-muted">Không tìm thấy dữ liệu phù hợp.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@item.MaPhieuTinh" class="fw-bold text-decoration-none">@item.MaPhieuTinh</a></td>
                            <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                            <td>
                                <small class="text-muted d-block">
                                    @item.TuNgay?.ToString("dd/MM") - @item.DenNgay?.ToString("dd/MM/yyyy")
                                </small>
                            </td>
                            <td>
                                @if(item.LoaiDoiTuong == "NCC") { <span class="badge bg-info text-dark">Nhập</span> }
                                else { <span class="badge bg-warning text-dark">Xuất</span> }
                            </td>
                            <td>
                                <div class="fw-bold">@item.TenDoiTuong</div>
                                <small class="text-muted">@item.MaDoiTuong</small>
                            </td>
                            <td class="text-muted fst-italic" style="max-width: 250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@item.QuyTacChietKhau">
                                @item.QuyTacChietKhau
                            </td>
                            <td>
                                @item.NgayThanhToan?.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end fw-bold text-success">
                                @string.Format("{0:N0}", item.TongTien)
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai == "Đã thanh toán")
                                {
                                    <span class="badge bg-success">@item.TrangThai</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.TrangThai</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.MaPhieuTinh" class="btn btn-sm btn-outline-primary" title="Xem Chi Tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Print" asp-route-id="@item.MaPhieuTinh" class="btn btn-sm btn-outline-secondary" title="In Phiếu" target="_blank">
                                    <i class="bi bi-printer"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
