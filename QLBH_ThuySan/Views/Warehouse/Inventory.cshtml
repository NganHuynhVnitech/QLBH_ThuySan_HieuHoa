@model IEnumerable<QLBH_ThuySan.Models.ChiTietTon>

@{
    ViewData["Title"] = "Tồn Kho";
    var warehouse = ViewBag.Warehouse as QLBH_ThuySan.Models.Kho;
}

<h2>Tồn Kho - @warehouse?.TenKho</h2>

<div class="card mb-3">
    <div class="card-body">
        <p>
            <strong>Mã Kho:</strong> @warehouse?.MaKho<br />
            <strong>Loại:</strong> @(warehouse?.LoaiKho == "Ao" ? "Kho Tổng Ảo" : "Kho Vật Lý")
            @if (warehouse?.MaDaiLyPhuTrachNavigation != null)
            {
                <br /><strong>Đại Lý Phụ Trách:</strong> @warehouse.MaDaiLyPhuTrachNavigation.TenDaiLy
            }
        </p>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã Hàng</th>
            <th>Tên Hàng</th>
            <th>Số Lượng Tồn</th>
            <th>Đơn Vị</th>
            <th>Giá Trị Tồn</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaHang</td>
                <td>@item.MaHangNavigation?.TenHang</td>
                <td>@((item.SoLuongTon ?? 0).ToString("N2"))</td>
                <td>@item.MaHangNavigation?.DonViTinh</td>
                <td>@((item.GiaTriTon ?? 0).ToString("N0")) VNĐ</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
