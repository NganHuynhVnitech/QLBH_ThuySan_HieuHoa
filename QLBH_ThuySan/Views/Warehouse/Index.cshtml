@model IEnumerable<QLBH_ThuySan.Models.Kho>

@{
    ViewData["Title"] = "Quản lý Kho";
}

<h2>Quản lý Kho</h2>

<div class="row mt-4">
    @foreach (var warehouse in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card @(warehouse.LoaiKho == "Ao" ? "border-primary" : "border-secondary")">
                <div class="card-header @(warehouse.LoaiKho == "Ao" ? "bg-primary text-white" : "bg-secondary text-white")">
                    <h5 class="mb-0">
                        @warehouse.TenKho
                        @if (warehouse.LoaiKho == "Ao")
                        {
                            <span class="badge bg-light text-primary">Kho Ảo</span>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        <strong>Mã Kho:</strong> @warehouse.MaKho<br />
                        <strong>Loại Kho:</strong> @warehouse.LoaiKho<br />
                        @if (warehouse.MaDaiLyPhuTrachNavigation != null)
                        {
                            <strong>Đại Lý Phụ Trách:</strong> @warehouse.MaDaiLyPhuTrachNavigation.TenDaiLy
                        }
                    </p>
                    <a asp-action="Inventory" asp-route-id="@warehouse.MaKho" class="btn btn-primary">
                        Xem Tồn Kho
                    </a>
                </div>
            </div>
        </div>
    }
</div>
