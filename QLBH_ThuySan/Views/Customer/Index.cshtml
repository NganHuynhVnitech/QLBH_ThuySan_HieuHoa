@model IEnumerable<QLBH_ThuySan.Models.KhachHang>

@{
    ViewData["Title"] = "Quản Lý Khách Hàng";
}

<div class="row pt-4 mb-4">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold">Danh Sách Khách Hàng</h1>
        <p class="text-muted">Quản lý thông tin khách hàng, ao nuôi và theo dõi dư nợ.</p>
    </div>
    <div class="col-md-4 text-end align-self-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Quay Lại
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Thêm Khách Hàng
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end" id="searchForm">
            <div class="col-md-2">
                <label for="searchMa" class="form-label small fw-bold text-uppercase">Mã KH</label>
                <input type="text" name="searchMa" id="searchMa" class="form-control form-control-sm" placeholder="Mã KH..." value="@ViewData["searchMa"]" />
            </div>
            <div class="col-md-2">
                <label for="searchTen" class="form-label small fw-bold text-uppercase">Tên Khách Hàng</label>
                <input type="text" name="searchTen" id="searchTen" class="form-control form-control-sm" placeholder="Tên khách hàng..." value="@ViewData["searchTen"]" />
            </div>
            <div class="col-md-2">
                <label for="searchSdt" class="form-label small fw-bold text-uppercase">Điện Thoại</label>
                <input type="text" name="searchSdt" id="searchSdt" class="form-control form-control-sm" placeholder="SĐT..." value="@ViewData["searchSdt"]" />
            </div>
            <div class="col-md-2">
                <label for="searchDiaChi" class="form-label small fw-bold text-uppercase">Địa Chỉ</label>
                <input type="text" name="searchDiaChi" id="searchDiaChi" class="form-control form-control-sm" placeholder="Địa chỉ..." value="@ViewData["searchDiaChi"]" />
            </div>
            <div class="col-md-2">
                <label for="searchAoNuoi" class="form-label small fw-bold text-uppercase">Ao Nuôi</label>
                <input type="text" name="searchAoNuoi" id="searchAoNuoi" class="form-control form-control-sm" placeholder="Ao nuôi..." value="@ViewData["searchAoNuoi"]" />
            </div>
            <div class="col-md-2 text-end">
                <div class="btn-group btn-group-sm w-100">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Tìm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa lọc">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-12 mt-2">
                <div class="form-check form-check-inline small">
                    <input class="form-check-input" type="checkbox" name="searchCoNo" id="searchCoNo" value="true" @((bool)(ViewData["searchCoNo"] ?? false) ? "checked" : "")>
                    <label class="form-check-label text-danger fw-bold" for="searchCoNo">
                        Chỉ hiện khách đang có dư nợ (>0)
                    </label>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        @{
                            var currentSort = ViewData["CurrentSort"] as string;
                            var searchParams = new Dictionary<string, string>
                            {
                                { "searchMa", ViewData["searchMa"]?.ToString() ?? "" },
                                { "searchTen", ViewData["searchTen"]?.ToString() ?? "" },
                                { "searchSdt", ViewData["searchSdt"]?.ToString() ?? "" },
                                { "searchDiaChi", ViewData["searchDiaChi"]?.ToString() ?? "" },
                                { "searchAoNuoi", ViewData["searchAoNuoi"]?.ToString() ?? "" },
                                { "searchCoNo", ViewData["searchCoNo"]?.ToString()?.ToLower() ?? "false" }
                            };

                            string GetSortIcon(string? sortOrder, string ascTarget, string descTarget)
                            {
                                if (sortOrder == ascTarget) return "<i class='bi bi-sort-up text-primary'></i>";
                                if (sortOrder == descTarget) return "<i class='bi bi-sort-down text-primary'></i>";
                                return "<i class='bi bi-arrow-down-up text-muted small'></i>";
                            }
                        }
                        <th class="ps-3">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["MaSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Mã KH @Html.Raw(GetSortIcon(currentSort, "", "ma_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["TenSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Tên Khách Hàng @Html.Raw(GetSortIcon(currentSort, "name_asc", "name_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["SdtSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Điện Thoại @Html.Raw(GetSortIcon(currentSort, "sdt_asc", "sdt_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["DiaChiSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Địa Chỉ @Html.Raw(GetSortIcon(currentSort, "addr_asc", "addr_desc"))
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["AoNuoiSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                Ao Nuôi @Html.Raw(GetSortIcon(currentSort, "pond_asc", "pond_desc"))
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-all-route-data="searchParams" asp-route-sortOrder="@ViewData["DebtSortParm"]" class="text-decoration-none text-dark small fw-bold text-uppercase">
                                @Html.Raw(GetSortIcon(currentSort, "debt_asc", "debt_desc")) Dư Nợ
                            </a>
                        </th>
                        <th class="text-center small fw-bold text-uppercase">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3"><span class="badge bg-light text-dark border">@item.MaDoiTuong</span></td>
                            <td class="fw-bold">@item.TenDoiTuong</td>
                            <td>@item.SoDienThoai</td>
                            <td>@item.DiaChi</td>
                            <td>@item.AoNuoi</td>
                            <td class="text-end fw-bold text-danger">@string.Format("{0:N0}", item.DuNoLuyKe)</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.MaDoiTuong" class="btn btn-outline-primary" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-controller="CustomerDebt" asp-action="Details" asp-route-id="@item.MaDoiTuong" class="btn btn-outline-success" title="Xem Chi Tiết Công Nợ">
                                        <i class="bi bi-journal-text"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaDoiTuong" title="Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@item.MaDoiTuong" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white py-2">
                                                <h5 class="modal-title font-size-sm"><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                Bạn có chắc chắn muốn xóa khách hàng <strong>@item.TenDoiTuong</strong>?<br/>
                                                <small class="text-danger d-block mt-2"><i class="bi bi-info-circle"></i> Lưu ý: Không thể xóa khách hàng nếu đang có lịch sử giao dịch hoặc công nợ.</small>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@item.MaDoiTuong">
                                                    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
