@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="text-center mb-5">
    <h1 class="display-4">Hệ Thống Quản Lý Thủy Sản Hiệu Hoa</h1>
    <p class="lead">Quản lý toàn diện hoạt động kinh doanh thủy sản</p>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-box-seam"></i> Quản Lý Kho
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    3 kho vật lý + 1 kho tổng ảo với tính năng tự động tính giá vốn bình quân gia quyền liên hoàn.
                </p>
                <a asp-controller="Warehouse" asp-action="Index" class="btn btn-primary">
                    Xem Kho
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="bi bi-journal-text"></i> Công Nợ Khách Hàng
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Theo dõi dư nợ, ghi nợ tích lũy và thanh toán của khách hàng.
                </p>
                <a asp-controller="CustomerDebt" asp-action="Index" class="btn btn-info text-white">
                    Xem Công Nợ KH
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-journal-arrow-down"></i> Công Nợ Đầu Vào
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Theo dõi công nợ nhập hàng và thời hạn thanh toán với Nhà cung cấp.
                </p>
                <a asp-controller="SupplierDebt" asp-action="Index" class="btn btn-warning text-dark">
                    Xem Công Nợ NCC
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="bi bi-people"></i> Quản Lý Khách Hàng
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Quản lý danh sách khách hàng, thông tin liên hệ và ao nuôi.
                </p>
                <a asp-controller="Customer" asp-action="Index" class="btn btn-info text-white">
                    Xem Khách Hàng
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-secondary">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-truck"></i> Quản Lý Nhà Cung Cấp
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Quản lý danh sách nhà cung cấp, đối tác nhập hàng và công nợ.
                </p>
                <a asp-controller="Supplier" asp-action="Index" class="btn btn-secondary">
                    Xem Nhà Cung Cấp
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-graph-up-arrow"></i> Báo Cáo Tài Chính
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Báo cáo P&L: Doanh thu - Giá vốn + Thu chiết khấu - Chi chiết khấu - Chi phí vận hành.
                </p>
                <a asp-controller="Financial" asp-action="ProfitLoss" class="btn btn-warning text-dark">
                    Xem Báo Cáo
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-cart-check"></i> Quản Lý Bán Hàng
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Tạo phiếu xuất kho bán hàng cho khách, quản lý doanh thu và công nợ phải thu.
                </p>
                <a asp-controller="Export" asp-action="Index" class="btn btn-primary">
                    Bán Hàng Ngay
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-box-arrow-in-down"></i> Quản Lý Nhập Hàng
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Tạo phiếu nhập kho từ nhà cung cấp, quản lý chi phí hàng hóa và công nợ phải trả.
                </p>
                <a asp-controller="Import" asp-action="Index" class="btn btn-success">
                    Nhập Hàng Ngay
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card bg-light mt-4">
    <div class="card-body">
        <h5 class="card-title">Công Nghệ Sử Dụng:</h5>
        <ul class="mb-0">
            <li><strong>ASP.NET Core MVC 10.0</strong> - Framework web hiện đại</li>
            <li><strong>Entity Framework Core</strong> - ORM cho .NET</li>
            <li><strong>SQL Server</strong> - Cơ sở dữ liệu quan hệ</li>
            <li><strong>Stored Procedures</strong> - Tính toán giá vốn bình quân gia quyền</li>
        </ul>
    </div>
</div>

